+    model_root = tmp_path / "model"
+    model_root.mkdir(mode=0o700)
+    cache = tmp_path / "cache" / "ple" / REVISION
+    values = (
+        (torch.arange(32 * 160, dtype=torch.float32).reshape(32, 160) % 31) / 16 - 1
+    ).to(torch.float8_e4m3fn)
+    raw_rows = values.view(torch.uint8).numpy().tobytes()
+    body = b""
+    header = {}
+    # Physical order intentionally differs from logical row order.
+    for i in (1, 0):
+        data = raw_rows[i * 16 * 160 : (i + 1) * 16 * 160]
+        header[f"{PREFIX}.shard_{i}.weight"] = {
+            "dtype": "F8_E4M3",
+            "shape": [16, 160],
+            "data_offsets": [len(body), len(body) + len(data)],
+        }
+        body += data
+    scale = (
+        torch.tensor([2.0], dtype=torch.bfloat16).view(torch.uint8).numpy().tobytes()
+    )
+    header[PREFIX + ".weight_scale"] = {
+        "dtype": "BF16",
+        "shape": [1],
+        "data_offsets": [len(body), len(body) + len(scale)],
+    }
+    body += scale
+    encoded = json.dumps(header).encode()
+    source = model_root / "tiny-ple.safetensors"
+    source.write_bytes(struct.pack("<Q", len(encoded)) + encoded + body)
+    plan = core.build_plan(
+        str(source),
+        model_id="nvidia/Qwen3.8-Flash-Next-NVFP4",
+        model_revision=REVISION,
+        tensor_prefix=PREFIX,
+        shard_count=2,
+        rows_per_shard=16,
+        row_width=160,
+        source_sha256=hashlib.sha256(source.read_bytes()).hexdigest(),
+    )
+    cold = core.prepare_cache(str(model_root), str(cache), plan)
+    warm = core.prepare_cache(str(model_root), str(cache), plan)
+    assert cold["mode"] == "materialized" and cold["copied_bytes"] == len(raw_rows)
+    assert warm["mode"] == "reuse" and warm["copied_bytes"] == 0
+    assert (cache / plan["table"]["name"]).read_bytes() == raw_rows
+    return cache, plan, warm, values
+
+
+def handoff(monkeypatch, receipt):
+    monkeypatch.setenv("R0B0TLAB_PLE_PREPARED_PATH", receipt["receipt_path"])
+    monkeypatch.setenv("R0B0TLAB_PLE_PREPARED_SHA256", receipt["receipt_sha256"])
+
+
+def source_embedding():
+    fields: dict[str, object] = {
+        name: 0 for name in Qwen4ExpPinnedHostEmbedding._COPIED_ATTRIBUTES
+    }
+    fields.update(
+        quant_config=None,
+        quant_method=UnquantizedEmbeddingMethod(),
+        enable_tp=False,
+        use_attn_tp_group=False,
+        tp_size=1,
+        num_embeddings=32,
+        org_vocab_size=32,
+        org_vocab_size_padded=32,
+        num_embeddings_padded=32,
+        num_embeddings_per_partition=32,
+        num_org_embeddings_per_partition=32,
+        embedding_dim=160,
+        shard_indices=SimpleNamespace(org_vocab_start_index=0, org_vocab_end_index=32),
+        weight=torch.nn.Parameter(
+            torch.empty(32, 160, dtype=torch.float8_e4m3fn), requires_grad=False
+        ),
+        weight_scale=torch.tensor([2.0], dtype=torch.bfloat16),
+    )
+    return SimpleNamespace(**fields)
+
+
+def test_real_core_handoff_preserves_fp8_bytes_and_rejects_drift(tmp_path, monkeypatch):
+    cache, plan, receipt, values = prepare_fixture(tmp_path)
+    handoff(monkeypatch, receipt)
+    table = allocate_ple_host_table(
+        (32, 160), torch.float8_e4m3fn, "file", str(cache), tag="rows0-32"
+    )
+    assert table._sglang_ple_prepared is True
+    assert torch.equal(table.view(torch.uint8), values.view(torch.uint8))
+    os.utime(cache / plan["table"]["name"], ns=(10**18, 10**18))
+    with pytest.raises(core.PleCacheError):
+        allocate_ple_host_table(
+            (32, 160), torch.float8_e4m3fn, "file", str(cache), tag="rows0-32"
+        )
+
+
+@pytest.mark.skipif(
+    not torch.cuda.is_available(), reason="native CUDA/HMM gather required"
+)
+def test_real_prepared_file_native_gather_and_graph_replay(tmp_path, monkeypatch):
+    check_file_backend_supported(torch.cuda.current_device())
+    cache, plan, receipt, values = prepare_fixture(tmp_path)
+    table_path = cache / plan["table"]["name"]
+    original_inode = table_path.stat().st_ino
+    handoff(monkeypatch, receipt)
+    source = source_embedding()
+    embedding = Qwen4ExpPinnedHostEmbedding(
+        source, backend="file", table_dir=str(cache)
+    )
+    try:
+        assert embedding._ple_prepared is True
+        assert embedding._file_rss_trimmer is not None
+        assert embedding._file_prefetcher is not None
+        assert embedding.weight_scale is source.weight_scale
+        ids = torch.tensor([0, 15, 16, 31], dtype=torch.int64, device="cuda")
+        expected = values.float()[[0, 15, 16, 31]].to(torch.bfloat16)
+        torch.testing.assert_close(
+            embedding.gather(ids).cpu(), expected, rtol=0, atol=0
+        )
+        torch.cuda.synchronize()
+        stream = torch.cuda.Stream()
+        stream.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(stream):
+            for _ in range(3):
+                embedding.gather(ids)
+        torch.cuda.current_stream().wait_stream(stream)
+        torch.cuda.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            output = embedding.gather(ids)
+        for order in ([31, 16, 15, 0], [1, 17, 2, 18]):
+            ids.copy_(torch.tensor(order, dtype=torch.int64, device="cuda"))
+            graph.replay()
+            torch.cuda.synchronize()
+            reference = values.float()[order].to(torch.bfloat16)
+            torch.testing.assert_close(output.cpu(), reference, rtol=0, atol=0)
+    finally:
+        if embedding._file_prefetcher is not None:
+            embedding._file_prefetcher.close()
+        if embedding._file_rss_trimmer is not None:
+            embedding._file_rss_trimmer.close()
+
+    # A real GPU access can change shared-file timestamps despite read-only
+    # kernel semantics. A whole-content-verified restart must retain the table.
+    del graph, output, embedding
+    repeated = core.prepare_cache(str(tmp_path / "model"), str(cache), plan)
+    assert repeated["mode"] == "reuse"
+    assert repeated["copied_bytes"] == 0
+    assert table_path.stat().st_ino == original_inode
+    assert (
+        hashlib.sha256(table_path.read_bytes()).hexdigest() == plan["table"]["sha256"]
+    )
