+        pv,sv=flashinfer.nvfp4_kv_quantize(v.reshape(-1,256),method.v_scales_gpu[3:4])
+        expected_k=flashinfer.nvfp4_kv_dequantize(pk,sk,method.k_scales_gpu[3:4],output_dtype=torch.bfloat16).reshape_as(k)
+        expected_v=flashinfer.nvfp4_kv_dequantize(pv,sv,method.v_scales_gpu[3:4],output_dtype=torch.bfloat16).reshape_as(v)
+        torch.testing.assert_close(graph_k,expected_k,rtol=.008,atol=.004)
+        torch.testing.assert_close(graph_v,expected_v,rtol=.008,atol=.004)
