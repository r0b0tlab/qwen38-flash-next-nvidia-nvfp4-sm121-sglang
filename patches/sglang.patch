@@ -0,0 +1,166 @@
+"""NVIDIA mixed MTP format and explicit draft-runner contracts (CPU)."""
+
+from types import SimpleNamespace
+from typing import Any
+from unittest.mock import patch
+
+import pytest
+import torch
+
+from sglang.srt.layers.linear import ReplicatedLinear
+from sglang.srt.layers.moe.fused_moe_triton import FusedMoE
+from sglang.srt.layers.moe.moe_runner.base import MoeRunnerConfig
+from sglang.srt.layers.moe import utils as moe_utils
+from sglang.srt.layers.moe.utils import MoeRunnerBackend
+from sglang.srt.layers.quantization import fp8 as fp8_module
+from sglang.srt.layers.quantization.fp8 import Fp8Config, Fp8LinearMethod, Fp8MoEMethod
+from sglang.srt.layers.quantization.modelopt_quant import ModelOptMixedPrecisionConfig
+from sglang.srt.models.qwen3_5_mtp import _mtp_quant_config
+from sglang.srt.runtime_context import get_flags
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=15, suite="base-a-test-cpu")
+
+
+@pytest.fixture(autouse=True)
+def restore_backend():
+    flags = get_flags().moe
+    original = flags.runner_backend
+    speculative = flags.speculative_runner_backend
+    flags.runner_backend = MoeRunnerBackend.TRITON
+    try:
+        yield
+    finally:
+        flags.runner_backend = original
+        flags.speculative_runner_backend = speculative
+
+
+def metadata(spelling, nested=False, **mtp_options) -> dict[str, Any]:
+    quant: dict[str, Any] = {
+        "quant_algo": "MIXED_PRECISION",
+        "ignore": [],
+        "exclude_modules": [],
+        "quantized_layers": {
+            "model.language_model.layers.0.mlp.experts": {
+                "quant_algo": "NVFP4",
+                "group_size": 16,
+            },
+            "mtp.layers.0.mlp.experts": {
+                "quant_algo": spelling,
+                "group_size": 128,
+                **mtp_options,
+            },
+            "mtp.fc_hidden": {"quant_algo": spelling, "group_size": 128},
+        },
+    }
+    return {"quantization": quant} if nested else quant
+
+
+@pytest.mark.parametrize("spelling", ["FP8_PB_WO", "FP8_BLOCK_SCALES"])
+@pytest.mark.parametrize("nested", [False, True])
+def test_actual_mixed_dispatch_and_mtp_retention(spelling, nested):
+    config = ModelOptMixedPrecisionConfig.from_config(metadata(spelling, nested))
+    moe = FusedMoE.__new__(FusedMoE)
+    torch.nn.Module.__init__(moe)
+    linear = ReplicatedLinear.__new__(ReplicatedLinear)
+    torch.nn.Module.__init__(linear)
+    moe_method = config.get_quant_method(moe, "mtp.layers.0.mlp.experts")
+    linear_method = config.get_quant_method(linear, "mtp.fc_hidden")
+    assert isinstance(moe_method, Fp8MoEMethod)
+    assert isinstance(linear_method, Fp8LinearMethod)
+    assert moe_method.quant_config is config.fp8_pb_wo_config
+    assert linear_method.quant_config is config.fp8_pb_wo_config
+    assert config.fp8_pb_wo_config.weight_block_size == [128, 128]
+    assert _mtp_quant_config(config) is config
+    assert config._resolve_quant_algo("model.layers.0.mlp.experts") == "NVFP4"
+    del config.quantized_layers["mtp.layers.0.mlp.experts"]
+    del config.quantized_layers["mtp.fc_hidden"]
+    assert _mtp_quant_config(config) is None
+
+
+@pytest.mark.parametrize("spelling", ["FP8_PB_WO", "FP8_BLOCK_SCALES"])
+@pytest.mark.parametrize("group", [256, 0, True, "128", 128.0])
+def test_reject_incompatible_explicit_group(spelling, group):
+    with pytest.raises(ValueError, match="128"):
+        ModelOptMixedPrecisionConfig.from_config(metadata(spelling, group_size=group))
+
+
+@pytest.mark.parametrize("nested", [False, True])
+def test_reject_incompatible_explicit_weight_blocks(nested):
+    raw = metadata("FP8_PB_WO", nested)
+    section = raw["quantization"] if nested else raw
+    section["weight_block_size"] = [256, 256]
+    with pytest.raises(ValueError, match="128"):
+        ModelOptMixedPrecisionConfig.from_config(raw)
+
+
+@pytest.mark.parametrize(
+    "backend",
+    [MoeRunnerBackend.FLASHINFER_CUTLASS, MoeRunnerBackend.FLASHINFER_CUTEDSL],
+)
+def test_explicit_unsupported_runner_is_not_silently_replaced(backend):
+    get_flags().moe.runner_backend = backend
+    method = Fp8MoEMethod(
+        Fp8Config(is_checkpoint_fp8_serialized=True, weight_block_size=[128, 128])
+    )
+    with pytest.raises(
+        NotImplementedError, match="speculative-moe-runner-backend triton"
+    ):
+        method.create_moe_runner(SimpleNamespace(), MoeRunnerConfig())
+    assert get_flags().moe.runner_backend is backend
+
+
+def test_draft_context_and_owned_forward_survive_target_restoration():
+    target = MoeRunnerBackend.CUTLASS
+    flags = get_flags().moe
+    flags.runner_backend = target
+    flags.speculative_runner_backend = MoeRunnerBackend.TRITON
+    sentinel = object()
+
+    class Runner:
+        def __init__(self, backend, config):
+            self.runner_backend = backend
+
+        def run(self, output, quant_info):
+            return sentinel
+
+    with patch.object(fp8_module, "MoeRunner", Runner):
+        with moe_utils.speculative_moe_backend_context():
+            method = Fp8MoEMethod(
+                Fp8Config(
+                    is_checkpoint_fp8_serialized=True, weight_block_size=[128, 128]
+                )
+            )
+            method.create_moe_runner(SimpleNamespace(), MoeRunnerConfig())
+        assert flags.runner_backend is target
+        assert method.runner.runner_backend is MoeRunnerBackend.TRITON
+        with (
+            patch.object(fp8_module, "use_intel_amx_backend", return_value=False),
+            patch.object(fp8_module, "is_xpu", return_value=False),
+            patch.object(method, "get_triton_quant_info", return_value=object()),
+        ):
+            output = method.apply(
+                SimpleNamespace(), SimpleNamespace(hidden_states=torch.zeros(1, 1))
+            )
+        assert output is sentinel
+
+
+def test_supported_direct_cutlass_backend_remains_explicit():
+    flags = get_flags().moe
+    flags.runner_backend = MoeRunnerBackend.CUTLASS
+    # Selection-only unit: the real constructor correctly rejects CUTLASS on
+    # this CPU test host. Device eligibility remains a separate GPU gate.
+    method = Fp8MoEMethod.__new__(Fp8MoEMethod)
+    method.create_moe_runner(SimpleNamespace(), MoeRunnerConfig())
+    flags.runner_backend = MoeRunnerBackend.TRITON
+    assert method._selected_moe_backend() is MoeRunnerBackend.CUTLASS
+    assert not method._owns_moe_runner
+
+
+def test_backend_without_fp8_execution_path_raises_at_creation():
+    get_flags().moe.runner_backend = MoeRunnerBackend.MARLIN
+    method = Fp8MoEMethod(
+        Fp8Config(is_checkpoint_fp8_serialized=True, weight_block_size=[128, 128])
+    )
+    with pytest.raises(NotImplementedError, match="Unsupported FP8 MoE"):
+        method.create_moe_runner(SimpleNamespace(), MoeRunnerConfig())
