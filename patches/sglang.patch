+def test_source_changed_during_copy_aborts(ple, tmp_path):
+    src, plan, model_root, cache = prepare_env(ple, tmp_path)
+    real_pwrite = os.pwrite
+    state = {"done": False}
+
+    def meddling_pwrite(fd, data, off):
+        if not state["done"]:
+            state["done"] = True
+            fd2 = os.open(str(src.path), os.O_WRONLY)
+            try:
+                real_pwrite(fd2, b"\xff", len(src.blob) - 3)
+            finally:
