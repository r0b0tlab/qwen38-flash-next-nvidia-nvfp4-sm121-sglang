+"""Compile/collection regressions; no CUDA imports or device calls."""
+
+import ast
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+SOURCE = (
+    Path(__file__).resolve().parents[4]
+    / "test/registered/kernel/embeddings/test_qwen4_ple_offload.py"
+)
+
+
+def test_gpu_test_module_compiles():
+    compile(SOURCE.read_bytes(), str(SOURCE), "exec")
+
+
+def _probe(available, result):
+    tree = ast.parse(SOURCE.read_text())
+    function = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.FunctionDef) and node.name == "_file_backend_supported"
+    )
+    function.body = [
+        node for node in function.body if not isinstance(node, ast.ImportFrom)
+    ]
+    calls = []
+
+    def device():
+        calls.append("device")
+        if not available:
+            raise RuntimeError("CPU collection initialized CUDA")
+        return 2
+
+    def capability(index):
+        calls.append(index)
+        return result
+
+    namespace = {
+        "torch": SimpleNamespace(
+            cuda=SimpleNamespace(is_available=lambda: available, current_device=device)
+        ),
+        "device_uses_host_page_tables": capability,
+    }
+    exec(
+        compile(
+            ast.fix_missing_locations(ast.Module(body=[function], type_ignores=[])),
+            "collection_probe",
+            "exec",
+        ),
+        namespace,
+    )
+    return namespace["_file_backend_supported"](), calls
+
+
+def test_cpu_collection_never_queries_current_device():
+    result, calls = _probe(False, True)
+    assert result is False and calls == []
+
+
+@pytest.mark.parametrize("result", [True, False, None])
+def test_cuda_collection_checks_actual_host_page_table_support(result):
+    actual, calls = _probe(True, result)
+    assert actual is (result is True)
+    assert calls == ["device", 2]
diff --git a/test/registered/unit/models/test_qwen4_ple_prepared.py b/test/registered/unit/models/test_qwen4_ple_prepared.py
