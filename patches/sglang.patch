+    rev='1'*40
+    value={'schema':'sglang.qsa.nvfp4-kv-scales.v1','model_revision':rev,'scale_policy':'bf16-amax-over-6x448',
+           'pools':{'target':{'layer_ids':[3],'heads':2,'head_dim':256,'observations':[1],'k_scale':[0.02],'v_scale':[0.03]}}}
+    p=tmp_path/'component-scales.json';p.write_text(json.dumps(value));p.chmod(0o600)
+    for name,value in {'SGLANG_QSA_KV_AMAX_CALIB':'0','SGLANG_QSA_KV_MODEL_REVISION':rev,'SGLANG_QSA_KV_SCALE_SIDECAR':str(p),'SGLANG_QSA_KV_SCALE_SHA256':hashlib.sha256(p.read_bytes()).hexdigest()}.items():
+        monkeypatch.setenv(name,value)
+    method=NVFP4KVCacheMethod(num_layers=1,device='cuda')
+    pool=QSATokenToKVPool(size=64,dtype=torch.float4_e2m1fn_x2,page_size=16,head_num=2,head_dim=256,
+        full_attention_layer_ids=[3],device='cuda',mamba_pool=None,qsa_index_kv_heads=2,qsa_index_head_dim=64,
+        qsa_compress_ratio=4,qsa_token_topk=8,num_request_slots=4,quant_method=method,qsa_calibration_role='target')
+    assert method.k_scales_gpu.shape==(4,) and method.k_scales_gpu[3].item()!=1
+    layer=SimpleNamespace(layer_id=3)
+    loc=torch.arange(16,20,device='cuda',dtype=torch.int64)
+    k=torch.randn(4,2,256,device='cuda',dtype=torch.bfloat16);v=torch.randn_like(k)
+    pool.set_kv_buffer(layer,loc,k,v)
+    raw=raw_nvfp4_layer(pool,3,256)
+    a,b=dequantize_nvfp4_rows(raw,loc,256)
+    fpk,fsk=flashinfer.nvfp4_kv_quantize(k.reshape(-1,256),method.k_scales_gpu[3:4]);fpv,fsv=flashinfer.nvfp4_kv_quantize(v.reshape(-1,256),method.v_scales_gpu[3:4])
+    ek=flashinfer.nvfp4_kv_dequantize(fpk,fsk,method.k_scales_gpu[3:4],output_dtype=torch.bfloat16).reshape_as(k)
+    ev=flashinfer.nvfp4_kv_dequantize(fpv,fsv,method.v_scales_gpu[3:4],output_dtype=torch.bfloat16).reshape_as(v)
+    torch.testing.assert_close(a,ek,rtol=0.008,atol=0.004);torch.testing.assert_close(b,ev,rtol=0.008,atol=0.004)
+    
+    for name in ('get_key_buffer','get_value_buffer','get_kv_buffer'):
+        with pytest.raises(ValueError,match='raw'):getattr(pool,name)(3)
+    graph=torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        pool.set_kv_buffer(layer,loc,k,v)
+        graph_k,graph_v=dequantize_nvfp4_rows(raw,loc,256)
+    for step in range(3):
+        k.copy_(torch.randn_like(k));v.copy_(torch.randn_like(v))
+        loc.copy_(torch.arange(32+step*4,36+step*4,device='cuda',dtype=torch.int64))
+        graph.replay();torch.cuda.synchronize()
