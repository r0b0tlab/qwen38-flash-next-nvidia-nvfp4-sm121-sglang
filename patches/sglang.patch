+"""Bounded, pure-stdlib PLE (precomputed lookup embedding) cache materializer.
+
+Materializes a contiguous FP8 lookup table from scattered per-shard tensors
+inside a large safetensors source file, with a verified warm-reuse contract:
+an existing table is reused only after a full SHA-256 check against the plan.
+Timestamp-only drift on the same inode gets a freshly bound receipt after
+verification; the native opener still requires its exact current fd-stat.
+
+Bounded I/O properties (fixed byte budgets, not measured speed claims):
+- sequential ``os.pread`` from the source, ``os.pwrite`` into a private
+  exclusive temp file, buffers capped at ``_IO_BUFFER_BYTES`` (8 MiB),
+- periodic ``os.fdatasync`` plus scoped ``posix_fadvise(DONTNEED)`` every
+  ``_FADVISE_INTERVAL_BYTES`` (64 MiB) to bound dirty page-cache growth,
+- header reads capped at 16 MiB, metadata/receipt reads at 1 MiB.
+
+Safety posture: any integrity or filesystem-safety failure raises
+``PleCacheError`` and aborts. There is no silent cold fallback past a safety
+refusal, no mmap, and no torch / third-party imports (safe to load via
+importlib from a file path).
+"""
+
+from __future__ import annotations
+
+import contextlib
+import errno
+import fcntl
+import hashlib
+import json
+import math
+import os
+import stat
+import time
+
+__all__ = [
+    "PleCacheError",
+    "CacheBusyError",
+    "build_plan",
+    "validate_plan",
+    "plan_sha256",
+    "prepare_cache",
+    "open_prepared_table",
+]
+
+_PLAN_SCHEMA = "qwen38fn.ple-plan.v1"
+_PREPARED_SCHEMA = "qwen38fn.ple-prepared.v1"
+_DTYPE = "F8_E4M3"
+_DTYPE_ITEMBYTES = {"F8_E4M3": 1, "F8_E5M2": 1, "BF16": 2, "F16": 2, "F32": 4, "F64": 8}
+_SCALE_DTYPE = "BF16"
+_MODEL_ID = "nvidia/Qwen3.8-Flash-Next-NVFP4"
+_REVISION_LEN = 40
+_NAME_CHARS = frozenset(
+    "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-+"
+)
+_HEX = frozenset("0123456789abcdef")
+
+_MAX_HEADER_BYTES = 16 * 1024 * 1024
+_MAX_META_BYTES = 1024 * 1024
+_IO_BUFFER_BYTES = 8 * 1024 * 1024
+_FADVISE_INTERVAL_BYTES = 64 * 1024 * 1024
+_SPACE_RESERVE_BYTES = 4 * 1024 * 1024 * 1024
+_NAME_MAX = 255
+_MAX_SHARDS = 4096
+_MAX_ROWS_PER_SHARD = 1 << 40
+_MAX_WIDTH = 1 << 24
+_MAX_TABLE_BYTES = (1 << 63) - 1
+_RECEIPT_NAME = "prepared.json"
+_STAT_KEYS = ("dev", "ino", "size", "mtime_ns", "ctime_ns")
+
+
+class PleCacheError(Exception):
+    """Safety or integrity failure: abort, never silently fall back."""
+
+
+class CacheBusyError(PleCacheError):
+    """Another process holds the exclusive cache lock."""
+
+
+# ---------------------------------------------------------------------------
+# strict scalar predicates
+
+
+def _is_int(v) -> bool:
+    return isinstance(v, int) and not isinstance(v, bool)
+
+
+def _is_hash(v) -> bool:
+    return isinstance(v, str) and len(v) == 64 and all(c in _HEX for c in v)
+
+
+def _is_revision(v) -> bool:
+    return isinstance(v, str) and len(v) == _REVISION_LEN and all(c in _HEX for c in v)
+
+
+def _check_index(value, what: str) -> int:
+    if not _is_int(value):
+        raise PleCacheError(f"{what} must be an integer (no bools)")
+    if value < 0:
+        raise PleCacheError(f"{what} must be non-negative")
+    return value
+
+
+def _check_hash(value, what: str) -> str:
+    if not _is_hash(value):
+        raise PleCacheError(f"{what} must be lower 64-hex sha256")
+    return value
+
+
+def _check_name(value, what: str) -> str:
+    if not isinstance(value, str):
+        raise PleCacheError(f"{what} must be a string")
+    if not value or len(value) > _NAME_MAX or "/" in value or value in (".", ".."):
+        raise PleCacheError(f"unsafe {what} name: {value!r}")
+    if any(c not in _NAME_CHARS for c in value):
+        raise PleCacheError(f"unsafe characters in {what} name: {value!r}")
+    return value
+
+
+def _require_keys(obj, keys, what: str) -> None:
+    if not isinstance(obj, dict) or set(obj) != set(keys):
+        got = (
+            sorted(str(key) for key in obj)
+            if isinstance(obj, dict)
+            else type(obj).__name__
+        )
+        raise PleCacheError(f"{what} keys must be exactly {sorted(keys)}, got {got}")
+
+
+def _canonical_json_bytes(obj) -> bytes:
+    return json.dumps(
+        obj, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
+    ).encode("ascii")
+
+
+def _sha256_hex(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+# ---------------------------------------------------------------------------
+# strict JSON
+
+
+def _load_strict_json(raw: bytes, what: str):
+    def _dup_check(pairs):
+        seen = set()
+        out = {}
+        for k, v in pairs:
+            if k in seen:
+                raise PleCacheError(f"{what}: duplicate JSON key {k!r}")
+            seen.add(k)
+            out[k] = v
+        return out
+
+    def _reject_constant(name):
+        raise PleCacheError(f"{what}: non-finite JSON constant {name}")
+
+    try:
+        obj = json.loads(
+            raw.decode("utf-8"),
+            object_pairs_hook=_dup_check,
+            parse_constant=_reject_constant,
+        )
+    except (ValueError, RecursionError) as exc:
+        raise PleCacheError(f"{what}: invalid JSON ({exc})") from None
+    _reject_nonfinite(obj, what)
+    return obj
+
+
+def _reject_nonfinite(obj, what: str) -> None:
+    pending = [(obj, 0)]
+    while pending:
+        value, depth = pending.pop()
+        if depth > 64:
+            raise PleCacheError(f"{what}: JSON nesting exceeds 64 levels")
+        if isinstance(value, dict):
+            if any(not isinstance(key, str) for key in value):
+                raise PleCacheError(f"{what}: non-string JSON key")
+            pending.extend((item, depth + 1) for item in value.values())
+        elif isinstance(value, list):
+            pending.extend((item, depth + 1) for item in value)
+        elif isinstance(value, float) and not math.isfinite(value):
+            raise PleCacheError(f"{what}: non-finite float in JSON")
+
+
+# ---------------------------------------------------------------------------
+# descriptor / path safety
+
+
+def _path_components(path_str: str, what: str) -> list[str]:
+    if (
+        not isinstance(path_str, str)
+        or not path_str.startswith("/")
+        or "\x00" in path_str
+    ):
+        raise PleCacheError(f"{what} must be an absolute path without NUL")
+    parts = [] if path_str == "/" else path_str.split("/")[1:]
+    if any(part in ("", ".", "..") for part in parts):
+        raise PleCacheError(f"{what} contains traversal or an empty component")
+    return parts
+
+
+def _open_dir(path_str: str, what: str, *, create: bool = False) -> int:
+    """Walk each component using directory fds; never follow ancestor links."""
+    parts = _path_components(path_str, what)
+    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
+    current = os.open("/", flags)
+    try:
+        for part in parts:
+            try:
+                child = os.open(part, flags, dir_fd=current)
+            except FileNotFoundError:
+                if not create:
+                    raise
+                try:
+                    os.mkdir(part, 0o700, dir_fd=current)
+                    os.fsync(current)
+                except FileExistsError:
+                    pass
+                child = os.open(part, flags, dir_fd=current)
+            os.close(current)
+            current = child
+        result = current
+        current = -1
+        return result
+    except OSError as exc:
+        raise PleCacheError(f"cannot open directory {what}: {exc}") from None
+    finally:
+        if current >= 0:
+            os.close(current)
+
+
+def _resolve_anchored(path_str: str, what: str) -> str:
+    parts = _path_components(path_str, what)
+    if not parts:
+        return path_str
+    parent = _open_dir(os.path.dirname(path_str), what + " parent")
+    try:
+        value = os.stat(parts[-1], dir_fd=parent, follow_symlinks=False)
+        if stat.S_ISLNK(value.st_mode):
+            raise PleCacheError(f"{what} is a symlink")
+    except OSError as exc:
+        raise PleCacheError(f"cannot resolve {what}: {exc}") from None
+    finally:
+        os.close(parent)
+    return path_str
+
+
+def _ensure_dir_anchored(path_str: str, what: str) -> str:
+    fd = _open_dir(path_str, what, create=True)
+    os.close(fd)
+    return path_str
+
+
+def _open_leaf(dir_fd: int, name: str, what: str, flags: int = os.O_RDONLY) -> int:
+    """Open a final path component relative to dir_fd, never following symlinks."""
+    try:
+        return os.open(
+            name,
+            flags | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK,
+            0o600,
+            dir_fd=dir_fd,
+        )
+    except OSError as exc:
+        raise PleCacheError(f"cannot open {what}: {exc}") from None
+
+
+def _require_regular_single_link(st: os.stat_result, what: str) -> None:
+    if stat.S_ISLNK(st.st_mode):
+        raise PleCacheError(f"{what} is a symlink")
+    if not stat.S_ISREG(st.st_mode):
+        raise PleCacheError(f"{what} is not a regular file")
+    if st.st_nlink != 1:
+        raise PleCacheError(
+            f"{what} must have exactly one hard link (got {st.st_nlink})"
+        )
+
+
+def _require_owned_mode(st: os.stat_result, what: str) -> None:
+    """Cache artifacts must be owner-held and not group/other writable."""
+    if st.st_uid != os.geteuid():
+        raise PleCacheError(f"{what} is owned by uid {st.st_uid}, not current user")
+    if st.st_mode & 0o022:
+        raise PleCacheError(
+            f"{what} is group/other writable (mode {oct(st.st_mode & 0o777)})"
+        )
+
+
+def _stat_snapshot(st: os.stat_result) -> dict:
+    return {
+        "dev": int(st.st_dev),
+        "ino": int(st.st_ino),
+        "size": int(st.st_size),
+        "mtime_ns": int(st.st_mtime_ns),
+        "ctime_ns": int(st.st_ctime_ns),
+    }
+
+
+def _stats_equal(a, b) -> bool:
+    return (
+        isinstance(a, dict)
+        and isinstance(b, dict)
+        and all(_is_int(a.get(k)) and a.get(k) == b.get(k) for k in _STAT_KEYS)
+    )
+
+
+def _validate_stat_snapshot(obj, what: str) -> None:
+    _require_keys(obj, _STAT_KEYS, what)
+    for k in _STAT_KEYS:
+        _check_index(obj[k], f"{what}.{k}")
+
+
+# ---------------------------------------------------------------------------
+# bounded byte-level primitives
+
+
+def _read_exact(fd: int, length: int, offset: int, what: str) -> bytes:
+    out = bytearray()
+    got = 0
+    while got < length:
+        chunk = os.pread(fd, min(_IO_BUFFER_BYTES, length - got), offset + got)
+        if not chunk:
+            raise PleCacheError(f"{what}: short read at {got}/{length} (eof)")
+        out += chunk
+        got += len(chunk)
+    return bytes(out)
+
+
+def _pwrite_all(fd: int, data: bytes, offset: int, what: str) -> None:
+    view = memoryview(data)
+    off = offset
+    while view.nbytes:
+        try:
+            n = os.pwrite(fd, view, off)
+        except OSError as exc:
+            raise PleCacheError(f"{what}: write failed: {exc}") from None
+        if not n:
+            raise PleCacheError(f"{what}: short write at offset {off}")
+        view = view[n:]
+        off += n
+
+
+def _hash_fd_range(fd: int, length: int, offset: int, what: str, logical=None) -> str:
+    """Hash bounded chunks and release consumed clean cache pages."""
+    digest = hashlib.sha256()
+    got = advised = 0
+    while got < length:
+        try:
+            chunk = os.pread(fd, min(_IO_BUFFER_BYTES, length - got), offset + got)
+        except OSError as exc:
+            raise PleCacheError(f"{what}: hash read failed: {exc}") from None
+        if not chunk:
+            raise PleCacheError(f"{what}: short read while hashing at {got}/{length}")
+        digest.update(chunk)
+        if logical is not None:
+            logical.update(chunk)
+        got += len(chunk)
+        if got - advised >= _FADVISE_INTERVAL_BYTES:
+            _fadvise_dontneed(fd, offset + advised, got - advised)
+            advised = got
+    if got > advised:
+        _fadvise_dontneed(fd, offset + advised, got - advised)
+    return digest.hexdigest()
+
+
+def _hash_whole_file(fd: int, size: int, what: str) -> str:
+    return _hash_fd_range(fd, size, 0, what)
+
+
+def _fadvise_dontneed(fd: int, offset: int, length: int) -> None:
+    if hasattr(os, "posix_fadvise") and hasattr(os, "POSIX_FADV_DONTNEED"):
+        with contextlib.suppress(OSError):
+            os.posix_fadvise(fd, offset, length, os.POSIX_FADV_DONTNEED)
+
+
+def _copy_range(
+    src_fd: int,
+    dst_fd: int,
+    src_offset: int,
+    dst_offset: int,
+    length: int,
+    what: str,
+) -> None:
+    """Copy [src_offset, src_offset+length) to dst_offset via bounded pread/pwrite.
+
+    Issues fdatasync + scoped fadvise(DONTNEED) every _FADVISE_INTERVAL_BYTES
+    on the destination and DONTNEED on the source span already consumed.
+    """
+    remaining = length
+    since_sync = 0
+    while remaining > 0:
+        want = min(_IO_BUFFER_BYTES, remaining)
+        done_so_far = length - remaining
+        chunk = os.pread(src_fd, want, src_offset + done_so_far)
+        if not chunk:
+            raise PleCacheError(
+                f"{what}: short read from source at {done_so_far}/{length}"
+            )
+        _pwrite_all(dst_fd, chunk, dst_offset + done_so_far, what)
+        remaining -= len(chunk)
+        since_sync += len(chunk)
+        if since_sync >= _FADVISE_INTERVAL_BYTES:
+            os.fdatasync(dst_fd)
+            consumed = length - remaining
+            _fadvise_dontneed(src_fd, src_offset, consumed)
+            _fadvise_dontneed(dst_fd, dst_offset, consumed)
+            since_sync = 0
+    # Flush the tail too: many sub-interval shards must not accumulate dirty pages.
+    os.fdatasync(dst_fd)
+    _fadvise_dontneed(src_fd, src_offset, length)
+    _fadvise_dontneed(dst_fd, dst_offset, length)
+
+
+def _read_safetensors_header(fd: int, file_size: int, what: str):
+    if file_size < 8:
+        raise PleCacheError(f"{what}: too small for safetensors")
+    (hlen,) = (
+        int.from_bytes(_read_exact(fd, 8, 0, f"{what} header length"), "little"),
+    )
+    if hlen == 0 or hlen > _MAX_HEADER_BYTES:
+        raise PleCacheError(f"{what}: header length out of bounds: {hlen}")
+    if 8 + hlen > file_size:
+        raise PleCacheError(f"{what}: header extends past end of file")
+    header_bytes = _read_exact(fd, hlen, 8, f"{what} header")
+    header = _load_strict_json(header_bytes, f"{what} header JSON")
+    if not isinstance(header, dict):
+        raise PleCacheError(f"{what}: header must be a JSON object")
+    return header, header_bytes, 8 + hlen
+
+
+def _dtype_item_bytes(dtype: str):
+    return _DTYPE_ITEMBYTES.get(dtype)
+
+
+def _check_header_entry(name: str, spec, data_start: int, file_size: int) -> None:
+    if not isinstance(spec, dict):
+        raise PleCacheError(f"{what_name(name)}: header entry malformed")
+    dtype = spec.get("dtype")
+    shape = spec.get("shape")
+    offs = spec.get("data_offsets")
+    if not isinstance(dtype, str):
+        raise PleCacheError(f"{what_name(name)}: dtype malformed")
+    if not isinstance(shape, list) or not all(_is_int(x) and x >= 0 for x in shape):
+        raise PleCacheError(f"{what_name(name)}: shape malformed")
+    if (
+        not isinstance(offs, list)
+        or len(offs) != 2
+        or not all(_is_int(x) and x >= 0 for x in offs)
+        or offs[0] > offs[1]
+    ):
+        raise PleCacheError(f"{what_name(name)}: data_offsets malformed")
+    begin, end = data_start + offs[0], data_start + offs[1]
+    if offs[0] < 0:
+        raise PleCacheError(f"{what_name(name)}: negative offset")
+    if begin < data_start or end > file_size:
+        raise PleCacheError(f"{what_name(name)}: range outside file data region")
+    item = _dtype_item_bytes(dtype)
+    if item is not None:
+        expected = item
+        for dim in shape:
+            expected *= dim
+        if end - begin != expected:
+            raise PleCacheError(
+                f"{what_name(name)}: byte length disagrees with shape/dtype"
+            )
+
+
+def what_name(name: str) -> str:
+    return f"source tensor {name!r}"
+
+
+def _check_header_global(header: dict, data_start: int, file_size: int) -> None:
+    """All tensor ranges in-bounds and pairwise non-overlapping."""
+    spans = []
+    for name, spec in header.items():
+        if name == "__metadata__":
+            if not isinstance(spec, dict):
+                raise PleCacheError("source header __metadata__ must be an object")
+            continue
+        _check_header_entry(name, spec, data_start, file_size)
+        begin = data_start + spec["data_offsets"][0]
+        end = data_start + spec["data_offsets"][1]
+        spans.append((begin, end, name))
+    spans.sort()
+    for (b1, e1, n1), (b2, e2, n2) in zip(spans, spans[1:]):
+        if e1 > b2:
+            raise PleCacheError(f"source header: tensors {n1!r} and {n2!r} overlap")
+
+
+def _shard_tensor_name(prefix: str, i: int) -> str:
+    return f"{prefix}.shard_{i}.weight"
+
+
+# ---------------------------------------------------------------------------
+# plan construction
+
+
+def build_plan(
+    source_path: str,
+    *,
+    model_id: str,
+    model_revision: str,
+    tensor_prefix: str,
+    shard_count,
+    rows_per_shard,
+    row_width,
+    source_sha256: str,
+) -> dict:
+    """Build a validated ``qwen38fn.ple-plan.v1`` plan from a real safetensors file.
+
+    Verifies the whole source file SHA-256 against the independently supplied
+    ``source_sha256``, validates the header and every PLE tensor, derives
+    per-shard / scale hashes and the logical table SHA in NUMERIC row order.
+    Rejects symlinks, traversal, and hard-linked sources.
+    """
+    if not isinstance(model_id, str) or model_id != _MODEL_ID:
+        raise PleCacheError(f"model_id must be {_MODEL_ID!r}")
+    if not _is_revision(model_revision):
+        raise PleCacheError("model_revision must be 40 lowercase hex chars")
+    if not isinstance(tensor_prefix, str) or not tensor_prefix:
+        raise PleCacheError("tensor_prefix must be a non-empty string")
+    for part in tensor_prefix.split("."):
+        _check_name(part, "tensor_prefix component")
+    _check_hash(source_sha256, "source_sha256")
+    shard_count = _check_index(shard_count, "shard_count")
+    rows_per_shard = _check_index(rows_per_shard, "rows_per_shard")
+    row_width = _check_index(row_width, "row_width")
+    if not 1 <= shard_count <= _MAX_SHARDS:
+        raise PleCacheError(f"shard_count out of range: {shard_count}")
+    if not 1 <= rows_per_shard <= _MAX_ROWS_PER_SHARD:
+        raise PleCacheError(f"rows_per_shard out of range: {rows_per_shard}")
+    if not 1 <= row_width <= _MAX_WIDTH:
+        raise PleCacheError(f"row_width out of range: {row_width}")
+    table_rows = shard_count * rows_per_shard
+    if table_rows > _MAX_TABLE_BYTES // row_width:
+        raise PleCacheError("table geometry overflows size bounds")
+
+    source_path = _resolve_anchored(source_path, "source")
+    dir_fd = _open_dir(os.path.dirname(source_path) or "/", "source directory")
+    try:
+        fd = _open_leaf(dir_fd, os.path.basename(source_path), "source")
+        try:
+            plan = _build_plan_from_fd(
+                fd,
+                source_name=os.path.basename(source_path),
+                model_id=model_id,
+                model_revision=model_revision,
+                tensor_prefix=tensor_prefix,
+                shard_count=shard_count,
+                rows_per_shard=rows_per_shard,
+                row_width=row_width,
+                expected_sha=source_sha256,
+            )
+        finally:
+            os.close(fd)
+    finally:
+        os.close(dir_fd)
+    validate_plan(plan)
+    return plan
+
+
+def _build_plan_from_fd(
+    fd: int,
+    *,
+    source_name: str,
+    model_id: str,
+    model_revision: str,
+    tensor_prefix: str,
+    shard_count: int,
+    rows_per_shard: int,
+    row_width: int,
+    expected_sha: str,
+) -> dict:
+    st = os.fstat(fd)
+    _require_regular_single_link(st, "source")
+    file_size = st.st_size
+    st_before = _stat_snapshot(st)
+
+    actual_sha = _hash_whole_file(fd, file_size, "source")
+    st_after = _stat_snapshot(os.fstat(fd))
+    if not _stats_equal(st_before, st_after):
+        raise PleCacheError("source changed while hashing")
+    if actual_sha != expected_sha:
+        raise PleCacheError(
+            "source sha256 mismatch: pinned hash does not match file content"
+        )
+
+    header, header_bytes, data_start = _read_safetensors_header(fd, file_size, "source")
+    _check_header_global(header, data_start, file_size)
+
+    scale_name = f"{tensor_prefix}.weight_scale"
+    scale_spec = header.get(scale_name)
+    if not isinstance(scale_spec, dict):
+        raise PleCacheError(f"missing scale tensor {scale_name!r} in source header")
+    if scale_spec["dtype"] != _SCALE_DTYPE or scale_spec["shape"] != [1]:
+        raise PleCacheError("scale tensor must be BF16 with shape [1]")
+    scale_off = data_start + scale_spec["data_offsets"][0]
+    scale_len = scale_spec["data_offsets"][1] - scale_spec["data_offsets"][0]
+    if scale_len != 2:
+        raise PleCacheError("scale tensor must be exactly 2 bytes")
+
+    expected_names = {_shard_tensor_name(tensor_prefix, i) for i in range(shard_count)}
+    present_names = {
+        name for name in header if name.startswith(tensor_prefix + ".shard_")
+    }
+    if present_names != expected_names:
+        raise PleCacheError("source PLE shard inventory is not the exact literal set")
+    shard_bytes = rows_per_shard * row_width
+    segments = []
+    for i in range(shard_count):
+        name = _shard_tensor_name(tensor_prefix, i)
+        spec = header.get(name)
+        if not isinstance(spec, dict):
+            raise PleCacheError(f"missing shard tensor {name!r} in source header")
+        if spec["dtype"] != _DTYPE:
+            raise PleCacheError(f"shard tensor {name!r} dtype must be {_DTYPE}")
+        if spec["shape"] != [rows_per_shard, row_width]:
+            raise PleCacheError(
+                f"shard tensor {name!r} shape must be [{rows_per_shard}, {row_width}]"
+            )
+        begin = data_start + spec["data_offsets"][0]
+        end = data_start + spec["data_offsets"][1]
+        if end - begin != shard_bytes:
+            raise PleCacheError(f"shard tensor {name!r} byte length mismatch")
+        segments.append({"id": i, "name": name, "offset": begin, "size": shard_bytes})
+
+    # Hash each shard once in logical row order. Physical checkpoint order can
+    # differ; buffering an entire shard or hashing the payload twice is unnecessary.
+    logical = hashlib.sha256()
+    shard_digests = {
+        seg["id"]: _hash_fd_range(
+            fd, seg["size"], seg["offset"], f"shard {seg['id']}", logical
+        )
+        for seg in segments
+    }
+    scale_sha = _hash_fd_range(fd, scale_len, scale_off, "scale")
+
+    st_final = _stat_snapshot(os.fstat(fd))
+    if not _stats_equal(st_before, st_final):
+        raise PleCacheError("source changed while planning")
+
+    table_rows = shard_count * rows_per_shard
+    table_size = table_rows * row_width
+    shards = [
+        {
+            "id": seg["id"],
+            "name": seg["name"],
+            "offset": seg["offset"],
+            "size": seg["size"],
+            "sha256": shard_digests[seg["id"]],
+        }
+        for seg in sorted(segments, key=lambda s: s["id"])
+    ]
+    plan = {
+        "schema": _PLAN_SCHEMA,
+        "model": {"id": model_id, "revision": model_revision},
+        "source": {
+            "name": _check_name(source_name, "source name"),
+            "size": file_size,
+            "sha256": actual_sha,
+            "header_sha256": _sha256_hex(header_bytes),
+            "data_start": data_start,
+        },
+        "tensor_prefix": tensor_prefix,
+        "dtype": _DTYPE,
+        "shard_count": shard_count,
+        "rows_per_shard": rows_per_shard,
+        "row_width": row_width,
+        "table": {
+            "name": _table_filename(table_rows, row_width, table_size),
+            "shape": [table_rows, row_width],
+            "size": table_size,
+            "sha256": logical.hexdigest(),
+        },
+        "scale": {
+            "name": scale_name,
+            "offset": scale_off,
+            "size": scale_len,
+            "sha256": scale_sha,
+        },
+        "shards": shards,
+    }
+    return plan
+
+
+def _table_filename(total_rows: int, row_width: int, size: int) -> str:
+    return f"ple_table_{total_rows}x{row_width}_float8_e4m3fn_{size}B_rows0-{total_rows}.bin"
+
+
+# ---------------------------------------------------------------------------
+# plan validation
+
+
+def validate_plan(plan) -> dict:
+    """Strictly validate a plan dict (exact keys/types/bounds); returns it."""
+    if not isinstance(plan, dict):
+        raise PleCacheError("plan must be a JSON object")
+    _require_keys(
+        plan,
+        [
+            "schema",
+            "model",
+            "source",
+            "tensor_prefix",
+            "dtype",
+            "shard_count",
+            "rows_per_shard",
+            "row_width",
+            "table",
+            "scale",
+            "shards",
+        ],
+        "plan",
+    )
+    if plan["schema"] != _PLAN_SCHEMA:
+        raise PleCacheError(f"plan schema must be {_PLAN_SCHEMA!r}")
+    _require_keys(plan["model"], ["id", "revision"], "plan.model")
+    if plan["model"]["id"] != _MODEL_ID:
+        raise PleCacheError("plan.model.id mismatch")
+    if not _is_revision(plan["model"]["revision"]):
+        raise PleCacheError("plan.model.revision must be 40 lowercase hex chars")
+
+    _require_keys(
+        plan["source"],
+        ["name", "size", "sha256", "header_sha256", "data_start"],
+        "plan.source",
+    )
+    src = plan["source"]
+    _check_name(src["name"], "plan.source.name")
+    _check_index(src["size"], "plan.source.size")
+    _check_hash(src["sha256"], "plan.source.sha256")
+    _check_hash(src["header_sha256"], "plan.source.header_sha256")
+    data_start = _check_index(src["data_start"], "plan.source.data_start")
+    if (
+        data_start < 8
+        or data_start > 8 + _MAX_HEADER_BYTES
+        or not data_start < src["size"] <= _MAX_TABLE_BYTES
+    ):
+        raise PleCacheError("plan.source.data_start/size incoherent")
+
+    if not isinstance(plan["tensor_prefix"], str) or not plan["tensor_prefix"]:
+        raise PleCacheError("plan.tensor_prefix must be a non-empty string")
+    for part in plan["tensor_prefix"].split("."):
+        _check_name(part, "plan.tensor_prefix component")
+    prefix = plan["tensor_prefix"]
+
+    if plan["dtype"] != _DTYPE:
+        raise PleCacheError(f"plan.dtype must be {_DTYPE!r}")
+
+    sc = _check_index(plan["shard_count"], "plan.shard_count")
+    rps = _check_index(plan["rows_per_shard"], "plan.rows_per_shard")
+    rw = _check_index(plan["row_width"], "plan.row_width")
+    if not 1 <= sc <= _MAX_SHARDS:
+        raise PleCacheError("plan.shard_count out of range")
+    if not 1 <= rps <= _MAX_ROWS_PER_SHARD:
+        raise PleCacheError("plan.rows_per_shard out of range")
+    if not 1 <= rw <= _MAX_WIDTH:
+        raise PleCacheError("plan.row_width out of range")
+    total_rows = sc * rps
+    if total_rows > _MAX_TABLE_BYTES // rw:
+        raise PleCacheError("plan table geometry overflow")
+    shard_bytes = rps * rw
+
+    _require_keys(plan["table"], ["name", "shape", "size", "sha256"], "plan.table")
+    tbl = plan["table"]
+    if not _is_int(tbl["size"]) or tbl["size"] != total_rows * rw:
+        raise PleCacheError("plan.table.size must equal total_rows * row_width")
+    if tbl["name"] != _table_filename(total_rows, rw, tbl["size"]):
+        raise PleCacheError("plan.table.name must be the geometry-derived filename")
+    if (
+        not isinstance(tbl["shape"], list)
+        or len(tbl["shape"]) != 2
+        or not _is_int(tbl["shape"][0])
+        or not _is_int(tbl["shape"][1])
+        or tbl["shape"] != [total_rows, rw]
+    ):
+        raise PleCacheError("plan.table.shape must be [total_rows, row_width]")
+    _check_hash(tbl["sha256"], "plan.table.sha256")
+
+    _require_keys(plan["scale"], ["name", "offset", "size", "sha256"], "plan.scale")
+    scale = plan["scale"]
+    if scale["name"] != f"{prefix}.weight_scale":
+        raise PleCacheError("plan.scale.name mismatch")
+    if not _is_int(scale["size"]) or scale["size"] != 2:
+        raise PleCacheError("plan.scale.size must be 2 (BF16 [1])")
+    _check_index(scale["offset"], "plan.scale.offset")
+    _check_hash(scale["sha256"], "plan.scale.sha256")
+    if scale["offset"] < data_start or scale["offset"] + scale["size"] > src["size"]:
+        raise PleCacheError("plan.scale range outside source file")
+
+    shards = plan["shards"]
+    if not isinstance(shards, list) or len(shards) != sc:
+        raise PleCacheError("plan.shards must be a list of exactly shard_count entries")
+    spans = []
+    for i, sh in enumerate(shards):
+        _require_keys(
+            sh, ["id", "name", "offset", "size", "sha256"], f"plan.shards[{i}]"
+        )
+        if not _is_int(sh["id"]) or sh["id"] != i:
+            raise PleCacheError(
+                f"plan.shards must be numeric-id ordered; shards[{i}].id={sh['id']!r}"
+            )
+        if sh["name"] != _shard_tensor_name(prefix, i):
+            raise PleCacheError(f"plan.shards[{i}].name is aliased or not canonical")
+        if not _is_int(sh["size"]) or sh["size"] != shard_bytes:
+            raise PleCacheError(
+                f"plan.shards[{i}].size must equal rows_per_shard*row_width"
+            )
+        off = _check_index(sh["offset"], f"plan.shards[{i}].offset")
+        if off < data_start or off + sh["size"] > src["size"]:
+            raise PleCacheError(f"plan.shards[{i}] range outside source file")
+        _check_hash(sh["sha256"], f"plan.shards[{i}].sha256")
+        spans.append((off, off + sh["size"]))
+    spans.append((scale["offset"], scale["offset"] + scale["size"]))
+    spans.sort()
+    for (b1, e1), (b2, e2) in zip(spans, spans[1:]):
+        if e1 > b2:
+            raise PleCacheError("plan.shards ranges overlap")
+    return plan
+
+
+def plan_sha256(plan: dict) -> str:
+    """Canonical-JSON SHA-256 of a validated plan (stable under key order)."""
+    return _sha256_hex(_canonical_json_bytes(validate_plan(plan)))
+
+
+# ---------------------------------------------------------------------------
+# cache preparation
+
+
+def prepare_cache(model_root: str, cache_dir: str, plan: dict) -> dict:
+    """Materialize the PLE table or verify-and-reuse an existing one.
+
+    Returns ``{receipt_path, receipt_sha256, mode, copied_bytes,
+    elapsed_seconds}`` where mode is exactly ``'materialized'`` (full copy,
+    ``copied_bytes`` = table size) or ``'reuse'`` (verified warm / adopted
+    legacy table, ``copied_bytes`` = 0). Raises on any safety/integrity
+    failure; never publishes a success receipt after a failed rename/fsync.
+    """
+    started = time.monotonic()
+    plan = validate_plan(plan)
+    _path_components(model_root, "model_root")
+    _path_components(cache_dir, "cache_dir")
+    if os.path.commonpath([model_root, cache_dir]) in (model_root, cache_dir):
+        raise PleCacheError("model_root and cache_dir must be disjoint")
+    model_root = _resolve_anchored(model_root, "model_root")
+    cache_dir = _ensure_dir_anchored(cache_dir, "cache_dir")
+    source_path = f"{model_root.rstrip('/')}/{plan['source']['name']}"
+
+    cache_fd = _open_dir(cache_dir, "cache_dir")
+    try:
+        _check_cache_root(cache_fd, cache_dir)
+        lock_fd = _acquire_lock(cache_fd, plan)
+        try:
+            return _prepare_locked(cache_fd, cache_dir, source_path, plan, started)
+        finally:
+            os.close(lock_fd)
+    finally:
+        os.close(cache_fd)
+
+
+def _check_cache_root(cache_fd: int, cache_dir: str) -> None:
+    st = os.fstat(cache_fd)
+    if st.st_uid != os.geteuid():
+        raise PleCacheError(f"cache_dir {cache_dir} is owned by uid {st.st_uid}")
+    if st.st_mode & 0o022:
+        raise PleCacheError(
+            f"cache_dir {cache_dir} is group/other writable (mode {oct(st.st_mode & 0o777)})"
+        )
+
+
+def _acquire_lock(cache_fd: int, plan: dict) -> int:
+    lock_name = f".{plan['table']['name']}.lock"
+    fd = _open_leaf(
+        cache_fd,
+        lock_name,
+        "cache lock",
+        flags=os.O_RDWR | os.O_CREAT,
+    )
+    try:
+        st = os.fstat(fd)
+        _require_regular_single_link(st, "cache lock")
+        _require_owned_mode(st, "cache lock")
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except OSError as exc:
+            if exc.errno in (errno.EACCES, errno.EAGAIN):
+                raise CacheBusyError("cache is locked by another process") from None
+            raise PleCacheError(f"cannot lock cache: {exc}") from None
+    except BaseException:
+        with contextlib.suppress(OSError):
+            os.close(fd)
+        raise
+    return fd
+
+
+def _prepare_locked(
+    cache_fd: int, cache_dir: str, source_path: str, plan: dict, started: float
+) -> dict:
+    receipt_path = f"{cache_dir.rstrip('/')}/{_RECEIPT_NAME}"
+    table_name = plan["table"]["name"]
+
+    src_dir_fd = _open_dir(os.path.dirname(source_path) or "/", "source directory")
+    try:
+        src_fd = _open_leaf(src_dir_fd, os.path.basename(source_path), "source")
+        try:
+            src_baseline = _verify_source(src_fd, plan)
+            receipt_exists = _file_exists(cache_fd, _RECEIPT_NAME)
+            receipt_raw, receipt = _load_receipt(cache_fd, plan)
+            existing = _open_existing(cache_fd, table_name, "cached table")
+            if existing is not None:
+                try:
+                    st = os.fstat(existing)
+                    _require_regular_single_link(st, "cached table")
+                    _require_owned_mode(st, "cached table")
+                    table_baseline = _stat_snapshot(st)
+                    valid = (
+                        receipt is not None
+                        and all(
+                            table_baseline[key] == receipt["table_stat"][key]
+                            for key in ("dev", "ino", "size")
+                        )
+                        and _stats_equal(src_baseline, receipt["source_stat"])
+                        and _verify_table_content(existing, plan["table"])
+                    )
+                    if valid and receipt is not None:
+                        if not _stats_equal(
+                            _stat_snapshot(os.fstat(src_fd)), src_baseline
+                        ):
+                            raise PleCacheError(
+                                "source changed during warm verification"
+                            )
+                        if not _stats_equal(
+                            _stat_snapshot(os.fstat(existing)), table_baseline
+                        ):
+                            raise PleCacheError(
+                                "table changed during warm verification"
+                            )
+                        if not _stats_equal(table_baseline, receipt["table_stat"]):
+                            # CUDA/HMM reads of a shared writable file mapping can
+                            # dirty its timestamps without changing payload bytes.
+                            # Full source/table hashes above remain mandatory;
+                            # renew only metadata for the same verified inode.
+                            receipt_raw = _finalize_receipt(
+                                cache_fd, plan, src_baseline, st
+                            )
+                        return _result(
+                            receipt_path, _sha256_hex(receipt_raw), "reuse", 0, started
+                        )
+                finally:
+                    os.close(existing)
+
+            # Only a receipt-less legacy file can be adopted; every adoption
+            # still hashes the whole table against the independently trusted plan.
+            table_fd = (
+                None
+                if receipt_exists
+                else _try_adopt_legacy(cache_fd, table_name, plan)
+            )
+            if table_fd is not None:
+                try:
+                    if not _stats_equal(_stat_snapshot(os.fstat(src_fd)), src_baseline):
+                        raise PleCacheError("source changed during legacy verification")
+                    receipt_bytes = _finalize_receipt(
+                        cache_fd, plan, src_baseline, os.fstat(table_fd)
+                    )
+                finally:
+                    os.close(table_fd)
+                return _result(
+                    receipt_path, _sha256_hex(receipt_bytes), "reuse", 0, started
+                )
+
+            copied = _materialize(cache_fd, src_fd, plan, src_baseline)
+            table_fd = _open_leaf(cache_fd, table_name, "published table")
+            try:
+                receipt_bytes = _finalize_receipt(
+                    cache_fd, plan, src_baseline, os.fstat(table_fd)
+                )
+            finally:
+                os.close(table_fd)
+            return _result(
+                receipt_path,
+                _sha256_hex(receipt_bytes),
+                "materialized",
+                copied,
+                started,
+            )
+        finally:
+            os.close(src_fd)
+    finally:
+        os.close(src_dir_fd)
+
+
+def _result(receipt_path, receipt_sha256, mode, copied_bytes, started) -> dict:
+    elapsed = time.monotonic() - started
+    return {
+        "receipt_path": receipt_path,
+        "receipt_sha256": receipt_sha256,
+        "mode": mode,
+        "copied_bytes": int(copied_bytes),
+        "elapsed_seconds": float(elapsed),
+    }
+
+
+def _file_exists(cache_fd: int, name: str) -> bool:
+    try:
+        os.lstat(name, dir_fd=cache_fd)
+        return True
+    except FileNotFoundError:
+        return False
+
+
+def _verify_source(src_fd: int, plan: dict) -> dict:
+    """Full always-on source verification: header, size, whole-file SHA."""
+    st = os.fstat(src_fd)
+    _require_regular_single_link(st, "source")
+    if st.st_size != plan["source"]["size"]:
+        raise PleCacheError(
+            f"source size changed: plan {plan['source']['size']}, file {st.st_size}"
+        )
+    header, header_bytes, data_start = _read_safetensors_header(
+        src_fd, st.st_size, "source"
+    )
+    if _sha256_hex(header_bytes) != plan["source"]["header_sha256"]:
+        raise PleCacheError("source header sha256 mismatch")
+    if data_start != plan["source"]["data_start"]:
+        raise PleCacheError("source data_start mismatch")
+    _check_header_global(header, data_start, st.st_size)
+    expected_names = {shard["name"] for shard in plan["shards"]}
+    observed_names = {
+        name for name in header if name.startswith(plan["tensor_prefix"] + ".shard_")
+    }
+    if observed_names != expected_names:
+        raise PleCacheError("source PLE names disagree with the plan")
+    for segment in [*plan["shards"], plan["scale"]]:
+        spec = header.get(segment["name"])
+        is_scale = segment is plan["scale"]
+        expected_dtype = "BF16" if is_scale else _DTYPE
+        expected_shape = (
+            [1] if is_scale else [plan["rows_per_shard"], plan["row_width"]]
+        )
+        if (
+            not isinstance(spec, dict)
+            or spec["dtype"] != expected_dtype
+            or spec["shape"] != expected_shape
+            or data_start + spec["data_offsets"][0] != segment["offset"]
+            or spec["data_offsets"][1] - spec["data_offsets"][0] != segment["size"]
+        ):
+            raise PleCacheError("source tensor metadata disagrees with the plan")
+    actual = _hash_whole_file(src_fd, st.st_size, "source")
+    st_after = _stat_snapshot(os.fstat(src_fd))
+    if not _stats_equal(_stat_snapshot(st), st_after):
+        raise PleCacheError("source changed while hashing")
+    if actual != plan["source"]["sha256"]:
+        raise PleCacheError("source sha256 mismatch")
+    return st_after
+
+
+def _open_existing(cache_fd: int, name: str, what: str):
+    """Open an existing cache leaf safely; None when missing."""
+    try:
+        st = os.lstat(name, dir_fd=cache_fd)
+    except FileNotFoundError:
+        return None
+    if stat.S_ISLNK(st.st_mode):
+        raise PleCacheError(f"{what} is a symlink: {name}")
+    if not stat.S_ISREG(st.st_mode):
+        raise PleCacheError(f"{what} is not a regular file: {name}")
+    return _open_leaf(cache_fd, name, what)
+
+
+def _load_receipt(cache_fd: int, plan: dict):
+    """Load prepared.json and match it against the plan.
+
+    Returns ``(raw_bytes, receipt_or_None)``; corrupt/mismatched/oversized
+    receipts yield ``(raw, None)`` so the caller falls through to the full
+    legacy-adoption / rebuild path instead of aborting.
+    """
+    fd = _open_existing(cache_fd, _RECEIPT_NAME, "receipt")
+    if fd is None:
+        return b"", None
+    try:
+        st = os.fstat(fd)
+        _require_regular_single_link(st, "receipt")
+        _require_owned_mode(st, "receipt")
+        if st.st_size > _MAX_META_BYTES:
+            return b"", None  # oversized: unusable, fall through to rebuild
+        raw = _read_exact(fd, st.st_size, 0, "receipt")
+    finally:
+        os.close(fd)
+    try:
+        obj = _load_strict_json(raw, "receipt")
+    except PleCacheError:
+        return raw, None  # corrupt or malformed receipt: rebuild, not abort
+    if _receipt_matches_plan(obj, plan):
+        return raw, obj
+    return raw, None
+
+
+def _receipt_matches_plan(obj, plan: dict) -> bool:
+    try:
+        _validate_receipt_schema(obj)
+        expected = {
+            "plan_sha256": plan_sha256(plan),
+            "model": plan["model"],
+            "source": {
+                "name": plan["source"]["name"],
+                "size": plan["source"]["size"],
+                "sha256": plan["source"]["sha256"],
+            },
+            "table": _receipt_table(plan),
+        }
+    except PleCacheError:
+        return False
+    for key, want in expected.items():
+        if obj.get(key) != want:
+            return False
+    return True
+
+
+def _receipt_table(plan: dict) -> dict:
+    rows, width = plan["table"]["shape"]
+    return {
+        "name": plan["table"]["name"],
+        "shape": [rows, width],
+        "size": plan["table"]["size"],
+        "sha256": plan["table"]["sha256"],
+        "dtype": _DTYPE,
+        "tag": f"rows0-{rows}",
+    }
+
+
+def _validate_receipt_schema(obj) -> None:
+    _require_keys(
+        obj,
+        [
+            "schema",
+            "plan_sha256",
+            "model",
+            "source",
+            "table",
+            "source_stat",
+            "table_stat",
+        ],
+        "receipt",
+    )
+    if obj["schema"] != _PREPARED_SCHEMA:
+        raise PleCacheError("receipt schema mismatch")
+    _check_hash(obj["plan_sha256"], "receipt.plan_sha256")
+    _require_keys(obj["model"], ["id", "revision"], "receipt.model")
+    if obj["model"]["id"] != _MODEL_ID:
+        raise PleCacheError("receipt.model.id mismatch")
+    if not _is_revision(obj["model"]["revision"]):
+        raise PleCacheError("receipt.model.revision malformed")
+    _require_keys(obj["source"], ["name", "size", "sha256"], "receipt.source")
+    _check_name(obj["source"]["name"], "receipt.source.name")
+    _check_index(obj["source"]["size"], "receipt.source.size")
+    _check_hash(obj["source"]["sha256"], "receipt.source.sha256")
+    _require_keys(
+        obj["table"],
+        ["name", "shape", "size", "sha256", "dtype", "tag"],
+        "receipt.table",
+    )
+    tbl = obj["table"]
+    _check_name(tbl["name"], "receipt.table.name")
+    if (
+        not isinstance(tbl["shape"], list)
+        or len(tbl["shape"]) != 2
+        or not all(_is_int(x) and x > 0 for x in tbl["shape"])
+    ):
+        raise PleCacheError("receipt.table.shape malformed")
+    if not _is_int(tbl["size"]) or tbl["size"] != tbl["shape"][0] * tbl["shape"][1]:
+        raise PleCacheError("receipt.table.size incoherent")
+    _check_hash(tbl["sha256"], "receipt.table.sha256")
+    if tbl["dtype"] != _DTYPE:
+        raise PleCacheError("receipt.table.dtype must be F8_E4M3")
+    if tbl["tag"] != f"rows0-{tbl['shape'][0]}":
+        raise PleCacheError("receipt.table.tag mismatch")
+    _validate_stat_snapshot(obj["source_stat"], "receipt.source_stat")
+    _validate_stat_snapshot(obj["table_stat"], "receipt.table_stat")
+    if (
+        obj["source_stat"]["size"] != obj["source"]["size"]
+        or obj["table_stat"]["size"] != tbl["size"]
+    ):
+        raise PleCacheError("receipt stat sizes disagree with declared file sizes")
+    if tbl["size"] > _MAX_TABLE_BYTES or obj["source"]["size"] > _MAX_TABLE_BYTES:
+        raise PleCacheError("receipt sizes exceed supported bounds")
+
+
+def _verify_table_content(table_fd: int, table: dict) -> bool:
+    """Full content hash of an existing table; False when stale/mismatched."""
+    st = os.fstat(table_fd)
+    if st.st_size != table["size"]:
+        return False
+    actual = _hash_whole_file(table_fd, st.st_size, "cached table")
+    st_after = _stat_snapshot(os.fstat(table_fd))
+    if not _stats_equal(_stat_snapshot(st), st_after):
+        raise PleCacheError("cached table changed while hashing")
+    return actual == table["sha256"]
+
+
+def _try_adopt_legacy(cache_fd: int, table_name: str, plan: dict):
+    """Adopt a receipt-less table ONLY after a full content hash."""
+    fd = _open_existing(cache_fd, table_name, "legacy table")
+    if fd is None:
+        return None
+    try:
+        st = os.fstat(fd)
+        _require_regular_single_link(st, "legacy table")
+        _require_owned_mode(st, "legacy table")
+        valid = _verify_table_content(fd, plan["table"])
+    except BaseException:
+        with contextlib.suppress(OSError):
+            os.close(fd)
+        raise
+    if valid:
+        return fd
+    os.close(fd)
+    return None
+
+
+def _preflight_space(cache_fd: int, table_size: int) -> None:
+    st = os.statvfs(cache_fd)
+    available = st.f_bavail * st.f_frsize
+    if available < table_size + _SPACE_RESERVE_BYTES:
+        raise PleCacheError(
+            f"insufficient cache space: need {table_size + _SPACE_RESERVE_BYTES}, have {available}"
+        )
+
+
+def _materialize(cache_fd: int, src_fd: int, plan: dict, src_baseline: dict) -> int:
+    """Cold path: exclusive temp, bounded copy in physical order, verify, publish.
+
+    Returns the number of bytes copied. On any failure the temp file is
+    removed and the previously published table (if any) is untouched.
+    """
+    table_name = plan["table"]["name"]
+    table_size = plan["table"]["size"]
+    _preflight_space(cache_fd, table_size)
+
+    tmp_name = f".{table_name}.tmp-{os.getpid()}-{os.urandom(6).hex()}"
+    tmp_fd = os.open(
+        tmp_name,
+        os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
+        0o600,
+        dir_fd=cache_fd,
+    )
+    published = False
+    tmp_open = True
+    try:
+        os.ftruncate(tmp_fd, table_size)
+        for shard in sorted(plan["shards"], key=lambda s: s["offset"]):
+            _copy_range(
+                src_fd,
+                tmp_fd,
+                shard["offset"],
+                shard["id"] * shard["size"],
+                shard["size"],
+                f"shard {shard['id']}",
+            )
+        os.fdatasync(tmp_fd)
+        _fadvise_dontneed(tmp_fd, 0, table_size)
+        # Verify the staged temp in logical (numeric row) order = file order.
+        staged = _hash_fd_range(tmp_fd, table_size, 0, "staged table")
+        if staged != plan["table"]["sha256"]:
+            raise PleCacheError("staged table sha256 mismatch after copy")
+        if not _stats_equal(_stat_snapshot(os.fstat(src_fd)), src_baseline):
+            raise PleCacheError("source changed during copy")
+        os.fsync(tmp_fd)
+        os.close(tmp_fd)
+        tmp_open = False
+        os.replace(tmp_name, table_name, src_dir_fd=cache_fd, dst_dir_fd=cache_fd)
+        published = True
+        # After replace the new table is committed in the namespace. A failed
+        # directory fsync is a failure, not permission to delete the new table.
+        os.fsync(cache_fd)
+        return table_size
+    except OSError as exc:
+        raise PleCacheError(f"materialization failed: {exc}") from None
+    finally:
+        if tmp_open:
+            with contextlib.suppress(OSError):
+                os.close(tmp_fd)
+        if not published:
+            with contextlib.suppress(OSError):
+                os.unlink(tmp_name, dir_fd=cache_fd)
+
+
+def _finalize_receipt(
+    cache_fd: int, plan: dict, source_stat: dict, table_st: os.stat_result
+) -> bytes:
+    """Write prepared.json atomically (tmp + fsync + replace + dir fsync)."""
+    receipt = {
+        "schema": _PREPARED_SCHEMA,
+        "plan_sha256": plan_sha256(plan),
+        "model": plan["model"],
+        "source": {
+            "name": plan["source"]["name"],
+            "size": plan["source"]["size"],
+            "sha256": plan["source"]["sha256"],
+        },
+        "table": _receipt_table(plan),
+        "source_stat": source_stat,
+        "table_stat": _stat_snapshot(table_st),
+    }
+    _validate_receipt_schema(receipt)
+    payload = _canonical_json_bytes(receipt)
+    tmp_name = f".{_RECEIPT_NAME}.tmp-{os.getpid()}-{os.urandom(6).hex()}"
+    tmp_fd = os.open(
+        tmp_name,
+        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
+        0o600,
+        dir_fd=cache_fd,
+    )
+    try:
+        _pwrite_all(tmp_fd, payload, 0, "receipt")
+        os.fsync(tmp_fd)
+        os.close(tmp_fd)
+        tmp_fd = -1
+        os.replace(tmp_name, _RECEIPT_NAME, src_dir_fd=cache_fd, dst_dir_fd=cache_fd)
+        os.fsync(cache_fd)
+        return payload
+    except OSError as exc:
+        raise PleCacheError(f"receipt finalization failed: {exc}") from None
+    finally:
+        if tmp_fd >= 0:
+            with contextlib.suppress(OSError):
+                os.close(tmp_fd)
+        # tmp no longer exists after a successful replace; suppress ENOENT.
+        with contextlib.suppress(OSError):
+            os.unlink(tmp_name, dir_fd=cache_fd)
+
+
+# ---------------------------------------------------------------------------
+# verified table open
+
+
+def open_prepared_table(
+    receipt_path: str,
+    expected_sha256: str,
+    *,
+    table_dir: str,
+    shape,
+    dtype: str,
+    tag: str,
+) -> int:
+    """Open the prepared table after full receipt verification; returns the fd.
+
+    The caller owns the returned read-only fd and must close it after mapping.
+    Verifies: receipt file SHA against ``expected_sha256``, strict schema and
+    types, model identity, table filename/shape/dtype/tag coherence, and an
+    exact current fd-stat match for the table. The table is opened read-only
+    relative to ``table_dir`` without following symlinks; the caller can map
+    ``/proc/self/fd/<fd>`` without re-hashing.
+    """
+    _check_hash(expected_sha256, "expected_sha256")
+    receipt_path = _resolve_anchored(receipt_path, "receipt_path")
+    table_dir = _resolve_anchored(table_dir, "table_dir")
+    if receipt_path != table_dir + "/" + _RECEIPT_NAME:
+        raise PleCacheError("receipt must be the fixed prepared.json in table_dir")
+    _validate_open_args(shape, dtype, tag)
+
+    receipt_dir_fd = _open_dir(
+        os.path.dirname(receipt_path) or "/", "receipt directory"
+    )
+    try:
+        fd = _open_leaf(receipt_dir_fd, os.path.basename(receipt_path), "receipt")
+        try:
+            st = os.fstat(fd)
+            _require_regular_single_link(st, "receipt")
+            _require_owned_mode(st, "receipt")
+            if st.st_size > _MAX_META_BYTES:
+                raise PleCacheError("receipt exceeds metadata size bound")
+            raw = _read_exact(fd, st.st_size, 0, "receipt")
+            if not _stats_equal(_stat_snapshot(st), _stat_snapshot(os.fstat(fd))):
+                raise PleCacheError("receipt changed while being read")
+        finally:
+            os.close(fd)
+    finally:
+        os.close(receipt_dir_fd)
+
+    if _sha256_hex(raw) != expected_sha256:
+        raise PleCacheError("receipt sha256 mismatch")
+    receipt = _load_strict_json(raw, "receipt")
+    _validate_receipt_schema(receipt)
+
+    rows, width = shape
+    if receipt["table"]["shape"] != [rows, width]:
+        raise PleCacheError("requested shape disagrees with receipt")
+    if receipt["model"]["id"] != _MODEL_ID:
+        raise PleCacheError("receipt model identity mismatch")
+    if receipt["table"]["dtype"] != dtype or receipt["table"]["tag"] != tag:
+        raise PleCacheError("receipt dtype/tag disagreement with request")
+    if receipt["table"]["name"] != _table_filename(rows, width, rows * width):
+        raise PleCacheError("receipt table filename is not geometry-derived")
+
+    table_dir_fd = _open_dir(table_dir, "table_dir")
+    try:
+        _check_cache_root(table_dir_fd, table_dir)
+        tfd = _open_existing(table_dir_fd, receipt["table"]["name"], "prepared table")
+        if tfd is None:
+            raise PleCacheError("prepared table file missing")
+        try:
+            st = os.fstat(tfd)
+            _require_regular_single_link(st, "prepared table")
+            _require_owned_mode(st, "prepared table")
+            if not _stats_equal(_stat_snapshot(st), receipt["table_stat"]):
+                raise PleCacheError(
+                    "prepared table stat does not match receipt (stale)"
+                )
+        except BaseException:
+            os.close(tfd)
+            raise
+    finally:
+        os.close(table_dir_fd)
+    return tfd
+
+
+def _validate_open_args(shape, dtype: str, tag: str) -> None:
+    if (
+        not isinstance(shape, (list, tuple))
+        or len(shape) != 2
+        or not all(_is_int(x) and x > 0 for x in shape)
+    ):
+        raise PleCacheError("shape must be a pair of positive integers")
+    if shape[0] > _MAX_TABLE_BYTES // shape[1]:
+        raise PleCacheError("requested table shape exceeds supported bounds")
+    if dtype != _DTYPE:
+        raise PleCacheError(f"dtype must be the literal {_DTYPE!r}")
+    if not isinstance(tag, str) or tag != f"rows0-{shape[0]}":
+        raise PleCacheError("tag must be rows0-<total_rows> matching shape")
