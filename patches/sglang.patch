+    assert r["mode"] == "reuse"
+    assert r["copied_bytes"] == 0
+
+
+def test_periodic_fdatasync_and_fadvise(ple, tmp_path, monkeypatch):
+    src, plan, model_root, cache = prepare_env(ple, tmp_path)
+    monkeypatch.setattr(ple, "_IO_BUFFER_BYTES", 7)
+    monkeypatch.setattr(ple, "_FADVISE_INTERVAL_BYTES", 13)
+    if not hasattr(os, "posix_fadvise"):
+        pytest.skip("posix_fadvise unavailable")
+    real_fdatasync = os.fdatasync
+    real_fadvise = os.posix_fadvise
+    counts = {"sync": 0, "advise": 0}
+
+    def counting_fdatasync(fd):
+        counts["sync"] += 1
+        return real_fdatasync(fd)
+
+    def counting_fadvise(fd, off, ln, advice):
+        counts["advise"] += 1
+        return real_fadvise(fd, off, ln, advice)
+
+    os.fdatasync = counting_fdatasync
+    try:
+        os.posix_fadvise = counting_fadvise
+        try:
+            r = ple.prepare_cache(str(model_root), str(cache), plan)
+        finally:
+            os.posix_fadvise = real_fadvise
+    finally:
+        os.fdatasync = real_fdatasync
+    assert r["mode"] == "materialized"
+    assert counts["sync"] >= src.n * 3  # two interval flushes plus a tail per shard
+    assert counts["advise"] >= src.n * 2
+
+
+# --------------------------------------------------------------------------
+# open_prepared_table
+
+
+def test_open_prepared_table_returns_owned_fd(ple, tmp_path):
+    src, plan, model_root, cache = prepare_env(ple, tmp_path)
+    r = ple.prepare_cache(str(model_root), str(cache), plan)
+    fd = ple.open_prepared_table(
+        r["receipt_path"],
+        r["receipt_sha256"],
+        table_dir=str(cache),
+        shape=plan["table"]["shape"],
+        dtype="F8_E4M3",
+        tag=f"rows0-{src.total_rows}",
+    )
+    try:
+        st = os.fstat(fd)
+        assert stat.S_ISREG(st.st_mode)
+        assert st.st_size == plan["table"]["size"]
+    finally:
+        os.close(fd)
+
+
+def _open_args(ple, r, src, cache, **over):
+    kw = {
+        "table_dir": str(cache),
+        "shape": [src.total_rows, src.width],
+        "dtype": "F8_E4M3",
+        "tag": f"rows0-{src.total_rows}",
+    }
+    kw.update(over)
+    return kw
+
+
+def test_open_prepared_table_rejects_bad_args(ple, tmp_path):
+    src, plan, model_root, cache = prepare_env(ple, tmp_path)
+    r = ple.prepare_cache(str(model_root), str(cache), plan)
+    cases = [
+        _open_args(ple, r, src, cache, dtype="BF16"),
+        _open_args(ple, r, src, cache, tag="rows0-1"),
+        _open_args(ple, r, src, cache, shape=[1, 1]),
+        _open_args(ple, r, src, cache, shape=True),
+    ]
+    for i, kw in enumerate(cases):
+        with pytest.raises(ple.PleCacheError) as exc:
+            ple.open_prepared_table(r["receipt_path"], r["receipt_sha256"], **kw)
+        assert issubclass(exc.type, ple.PleCacheError), f"case {i}"
+
+
+def test_open_prepared_table_rejects_wrong_receipt_sha(ple, tmp_path):
+    src, plan, model_root, cache = prepare_env(ple, tmp_path)
+    r = ple.prepare_cache(str(model_root), str(cache), plan)
+    with pytest.raises(ple.PleCacheError):
+        ple.open_prepared_table(
+            r["receipt_path"],
+            "0" * 64,
+            **_open_args(ple, r, src, cache),
+        )
+
+
+def test_open_prepared_table_rejects_tampered_but_rehashed(ple, tmp_path):
+    src, plan, model_root, cache = prepare_env(ple, tmp_path)
+    r = ple.prepare_cache(str(model_root), str(cache), plan)
+    receipt = json.loads((cache / "prepared.json").read_bytes())
+
+    receipt["model"]["revision"] = "f" * 39
+    (cache / "prepared.json").write_bytes(canonical_bytes(receipt))
+    bad_sha = hashlib.sha256(canonical_bytes(receipt)).hexdigest()
+    with pytest.raises(ple.PleCacheError):
+        ple.open_prepared_table(
+            r["receipt_path"], bad_sha, **_open_args(ple, r, src, cache)
+        )
+
+    receipt["model"]["revision"] = REVISION
+    receipt["table_stat"]["ino"] += 1
+    (cache / "prepared.json").write_bytes(canonical_bytes(receipt))
+    bad_sha = hashlib.sha256(canonical_bytes(receipt)).hexdigest()
+    with pytest.raises(ple.PleCacheError):
+        ple.open_prepared_table(
+            r["receipt_path"], bad_sha, **_open_args(ple, r, src, cache)
+        )
+
+    receipt["table_stat"]["size"] = True
+    (cache / "prepared.json").write_bytes(canonical_bytes(receipt))
+    bad_sha = hashlib.sha256(canonical_bytes(receipt)).hexdigest()
+    with pytest.raises(ple.PleCacheError):
+        ple.open_prepared_table(
+            r["receipt_path"], bad_sha, **_open_args(ple, r, src, cache)
+        )
+
+
+def test_open_prepared_table_rejects_escaping_table_name(ple, tmp_path):
+    src, plan, model_root, cache = prepare_env(ple, tmp_path)
+    r = ple.prepare_cache(str(model_root), str(cache), plan)
+    receipt = json.loads((cache / "prepared.json").read_bytes())
+    receipt["table"]["name"] = "../escape.bin"
+    (cache / "prepared.json").write_bytes(canonical_bytes(receipt))
+    bad_sha = hashlib.sha256(canonical_bytes(receipt)).hexdigest()
+    with pytest.raises(ple.PleCacheError):
+        ple.open_prepared_table(
+            r["receipt_path"], bad_sha, **_open_args(ple, r, src, cache)
+        )
+
+
+def test_open_prepared_table_rejects_stale_stat(ple, tmp_path):
+    src, plan, model_root, cache = prepare_env(ple, tmp_path)
+    r = ple.prepare_cache(str(model_root), str(cache), plan)
+    os.utime(cache / plan["table"]["name"], ns=(10**18, 10**18))
+    with pytest.raises(ple.PleCacheError):
+        ple.open_prepared_table(
+            r["receipt_path"], r["receipt_sha256"], **_open_args(ple, r, src, cache)
+        )
+
+
+def test_open_prepared_table_rejects_symlinked_table(ple, tmp_path):
+    src, plan, model_root, cache = prepare_env(ple, tmp_path)
+    r = ple.prepare_cache(str(model_root), str(cache), plan)
+    table = cache / plan["table"]["name"]
+    saved = table.read_bytes()
+    table.unlink()
+    other = tmp_path / "elsewhere.bin"
+    other.write_bytes(saved)
+    table.symlink_to(other)
+    with pytest.raises(ple.PleCacheError):
+        ple.open_prepared_table(
+            r["receipt_path"], r["receipt_sha256"], **_open_args(ple, r, src, cache)
+        )
+
+
+if __name__ == "__main__":
+    raise SystemExit(pytest.main([__file__, "-v"]))
