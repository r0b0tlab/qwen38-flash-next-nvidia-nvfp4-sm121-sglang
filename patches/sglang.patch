+++ b/test/registered/unit/models/test_qwen4_ple_prepared.py
@@ -0,0 +1,816 @@
+"""Prepared-PLE mapping and copy-elision hooks.
+
+NOT a core-integrity proof: the prepared-cache helper module
+``sglang.srt.models.qwen4_exp_ple_cache`` is developed on a separate isolated
+branch and is NOT readable from this workspace. Every helper-dependent test
+here injects a protocol double for it through ``sys.modules`` (labelled
+below); the real helper's receipt/digest/fd-safety validation and the
+descriptor + CUDA gather interop are proven by the controller on the merged
+tree, not here.
+
+CPU part (real execution, no GPU):
+- ``allocate_ple_host_table`` without the internal prepared env keeps the
+  upstream file-backed behaviour (same file name, shared bytes, MADV_RANDOM,
+  prefetcher path attribute) and never imports the helper.
+- With only one of the two prepared env vars set, or with malformed values
+  (sha256, dtype, backend, table_dir, tag), it fails closed BEFORE mutating
+  the table directory and before importing/calling the helper -- it never
+  falls back to the legacy rewrite.
+- The happy path imports the helper lazily, maps ``torch.from_file`` through
+  the ``/proc/self/fd/<fd>`` anchor (not an unchecked pathname), closes the
+  helper fd even on failure, and never creates/rewrites/truncates the legacy
+  table file.
+- fd-anchored mapping proof: the mapping keeps working after the descriptor
+  is closed (mapping + bytes preserved; the parent's real test re-proves this
+  with the genuine helper).
+- A real ``Qwen4ExpPinnedHostEmbedding.__init__`` over a minimal fake source
+  embedding captures the prepared flag onto the embedding object (it survives
+  the Parameter wrapping, which drops tensor custom attributes) and keeps the
+  prefetcher/RSS-trimmer wiring unconditional.
+- The real ``Qwen4ExpForConditionalGeneration.load_weights`` on a minimal
+  fake model copy-elides a well-formed prepared shard (no row payload copied,
+  param still registered, BF16 ``weight_scale`` buffer path executed) and
+  fails closed on a wrong shape, dtype, name, or shard id.
+
+GPU/interop part: none. The controller owns the real checkpoint, image and
+CUDA gather/replay verification.
+"""
+
+import os
+import sys
+import tempfile
+import types
+import unittest
+import unittest.mock as mock
+
+import torch
+
+from sglang.srt.models import qwen4_exp_ple_table as ple_table_mod
+from sglang.srt.models.qwen4_exp import (
+    Qwen4ExpForConditionalGeneration,
+    Qwen4ExpNGramEmbedding,
+    Qwen4ExpPinnedHostEmbedding,
+    _load_prepared_ple_shard,
+)
+from sglang.srt.models.qwen4_exp_ple_table import (
+    allocate_ple_host_table,
+    ple_table_file_name,
+)
+
+_HELPER_MODULE = "sglang.srt.models.qwen4_exp_ple_cache"
+
+_PREPARED_PATH_ENV = "R0B0TLAB_PLE_PREPARED_PATH"
+_PREPARED_SHA_ENV = "R0B0TLAB_PLE_PREPARED_SHA256"
+_PREPARED_ENV = {_PREPARED_PATH_ENV: "/tmp/receipt.json", _PREPARED_SHA_ENV: "ab" * 32}
+
+
+class _FakePleCache(types.ModuleType):
+    """PROTOCOL DOUBLE, not a core-integrity proof.
+
+    Stands in for the isolated-branch helper ``open_prepared_table`` whose
+    real implementation this workspace must not read or reimplement. It only
+    records the call and returns a read-only fd of the path it was given; it
+    deliberately does none of the real helper's receipt/digest/fd validation.
+    """
+
+    last_call = None
+
+    @staticmethod
+    def open_prepared_table(
+        receipt_path,
+        expected_sha256,
+        *,
+        table_dir,
+        shape,
+        dtype,
+        tag,
+    ):
+        # In production receipt_path is a receipt file that pins the table;
+        # the double opens it directly to hand back a real read-only fd.
+        _FakePleCache.last_call = {
+            "receipt_path": receipt_path,
+            "expected_sha256": expected_sha256,
+            "table_dir": table_dir,
+            "shape": list(shape),
+            "dtype": dtype,
+            "tag": tag,
+        }
+        return os.open(receipt_path, os.O_RDONLY)
+
+
+def _install_fake_helper():
+    saved = sys.modules.get(_HELPER_MODULE)
+    sys.modules[_HELPER_MODULE] = _FakePleCache(_HELPER_MODULE)
+    return saved
+
+
+def _restore_helper(saved):
+    if saved is None:
+        sys.modules.pop(_HELPER_MODULE, None)
+    else:
+        sys.modules[_HELPER_MODULE] = saved
+    _FakePleCache.last_call = None
+
+
+class _HelperDoubleMixin:
+    """Install/restore the protocol double around each test."""
+
+    def setUp(self):
+        self._saved_helper = _install_fake_helper()
+
+    def tearDown(self):
+        _restore_helper(self._saved_helper)
+
+
+def _write_table(path: str, payload: bytes) -> int:
+    with open(path, "wb") as f:
+        f.write(payload)
+    return os.stat(path).st_ino
+
+
+class TestUnpreparedPathUnchanged(unittest.TestCase):
+    """No prepared env: upstream behaviour, helper never imported."""
+
+    def test_absent_env_uses_legacy_file_backend(self):
+        with tempfile.TemporaryDirectory() as d:
+            table = allocate_ple_host_table((128, 32), torch.float8_e4m3fn, "file", d)
+            path = os.path.join(d, ple_table_file_name((128, 32), torch.float8_e4m3fn))
+            self.assertTrue(os.path.exists(path))
+            self.assertEqual(os.path.getsize(path), 128 * 32)
+            self.assertEqual(table._sglang_ple_file_path, path)
+            self.assertFalse(getattr(table, "_sglang_ple_prepared", False))
+            table[3].view(torch.uint8).fill_(7)
+            self.assertEqual(os.stat(path).st_size, 128 * 32)
+
+    def test_lazy_helper_not_imported_without_env(self):
+        # Test the import boundary, not global module-cache contents: another
+        # interoperability test may already have imported the genuine core.
+        original = __import__
+
+        def checked(name, *args, **kwargs):
+            if name == _HELPER_MODULE:
+                raise AssertionError("unprepared allocation must not import the helper")
+            return original(name, *args, **kwargs)
+
+        with mock.patch("builtins.__import__", checked):
+            with tempfile.TemporaryDirectory() as d:
+                allocate_ple_host_table((8, 8), torch.bfloat16, "file", d)
+
+
+class TestPreparedPathGuards(_HelperDoubleMixin, unittest.TestCase):
+    """Malformed or partial prepared env fails closed before any mutation."""
+
+    def _legacy_target(self, d, tag="rows0-16"):
+        return os.path.join(d, ple_table_file_name((16, 16), torch.float8_e4m3fn, tag))
+
+    def _assert_refused(
+        self,
+        env,
+        *,
+        dtype=torch.float8_e4m3fn,
+        backend="file",
+        table_dir="use-private-test-dir",
+        tag="rows0-16",
+    ):
+        with tempfile.TemporaryDirectory() as d:
+            call_dir = d if table_dir == "use-private-test-dir" else table_dir
+            with mock.patch.dict(os.environ, env, clear=False):
+                with self.assertRaises((ValueError, RuntimeError)):
+                    allocate_ple_host_table((16, 16), dtype, backend, call_dir, tag=tag)
+            # No table file was created/mutated (the legacy target is what the
+            # unprepared path would have created for these arguments).
+            self.assertFalse(
+                os.path.exists(
+                    self._legacy_target(d if call_dir is None else call_dir, tag)
+                )
+            )
+            # The failure happened before the helper was consulted.
+            self.assertIsNone(_FakePleCache.last_call)
+
+    def test_path_without_sha_refused(self):
+        self._assert_refused({_PREPARED_PATH_ENV: "/tmp/r.json"})
+
+    def test_sha_without_path_refused(self):
+        self._assert_refused({_PREPARED_SHA_ENV: "cd" * 32})
+
+    def test_empty_value_refused(self):
+        self._assert_refused({_PREPARED_PATH_ENV: "", _PREPARED_SHA_ENV: "ab" * 32})
+
+    def test_bad_sha_hex_refused(self):
+        self._assert_refused(
+            {_PREPARED_PATH_ENV: "/tmp/r.json", _PREPARED_SHA_ENV: "zz" * 32}
+        )
+
+    def test_short_sha_refused(self):
+        self._assert_refused(
+            {_PREPARED_PATH_ENV: "/tmp/r.json", _PREPARED_SHA_ENV: "ab" * 31}
+        )
+
+    def test_pinned_backend_with_prepared_env_refused(self):
+        self._assert_refused(dict(_PREPARED_ENV), backend="pinned", tag=None)
+
+    def test_bf16_table_with_prepared_env_refused(self):
+        self._assert_refused(dict(_PREPARED_ENV), dtype=torch.bfloat16)
+
+    def test_missing_table_dir_refused(self):
+        # table_dir=None would default from envs on the legacy path; prepared
+        # requires it explicitly and must refuse before touching anything.
+        self._assert_refused(dict(_PREPARED_ENV), table_dir=None, tag="rows0-16")
+
+    def test_bad_tag_refused(self):
+        with tempfile.TemporaryDirectory() as d:
+            with mock.patch.dict(os.environ, dict(_PREPARED_ENV), clear=False):
+                for tag in ("", "shard0-16", "rows16-0", "rows0-"):
+                    with self.assertRaises((ValueError, RuntimeError)):
+                        allocate_ple_host_table(
+                            (16, 16), torch.float8_e4m3fn, "file", d, tag=tag
+                        )
+            self.assertIsNone(_FakePleCache.last_call)
+
+
+class TestPreparedPathHappy(_HelperDoubleMixin, unittest.TestCase):
+    def test_prepared_mapping_anchored_and_untouched(self):
+        with tempfile.TemporaryDirectory() as d:
+            payload = bytes(range(256)) * 4  # 1024 B = 256 fp8 rows of 4
+            table_path = os.path.join(d, "prepared_table.bin")
+            inode = _write_table(table_path, payload)
+            env = {
+                _PREPARED_PATH_ENV: table_path,
+                _PREPARED_SHA_ENV: "ef" * 32,
+            }
+            real_from_file = torch.from_file
+            seen = {}
+
+            def spy_from_file(path, *args, **kwargs):
+                seen["path"] = path
+                return real_from_file(path, *args, **kwargs)
+
+            with mock.patch.dict(os.environ, env, clear=False):
+                with mock.patch.object(torch, "from_file", spy_from_file):
+                    table = allocate_ple_host_table(
+                        (256, 4), torch.float8_e4m3fn, "file", d, tag="rows0-256"
+                    )
+            # The helper got the locked contract: string dtype literal, full
+            # plan identity, explicit table_dir and the rows tag.
+            call = _FakePleCache.last_call
+            self.assertIsNotNone(call)
+            self.assertEqual(call["receipt_path"], env[_PREPARED_PATH_ENV])
+            self.assertEqual(call["expected_sha256"], env[_PREPARED_SHA_ENV])
+            self.assertEqual(call["table_dir"], d)
+            self.assertEqual(call["shape"], [256, 4])
+            self.assertEqual(call["dtype"], "F8_E4M3")
+            self.assertEqual(call["tag"], "rows0-256")
+            # The map went through the fd anchor, not an unchecked pathname.
+            self.assertTrue(
+                seen["path"].startswith("/proc/self/fd/"),
+                f"mapping did not anchor on /proc/self/fd: {seen.get('path')!r}",
+            )
+            self.assertNotEqual(seen["path"], table_path)
+            # Bytes preserved from the verified file.
+            self.assertEqual(bytes(table.view(torch.uint8).flatten().tolist()), payload)
+            # Writes land on the verified inode (shared mapping) and the file
+            # was never rewritten or truncated by the allocator.
+            self.assertEqual(os.stat(table_path).st_ino, inode)
+            table.view(torch.uint8)[0] = 0xAA
+            with open(table_path, "rb") as f:
+                self.assertEqual(f.read(1), b"\xaa")
+            self.assertEqual(os.path.getsize(table_path), len(payload))
+            # No canonical legacy file was created (nothing was rewritten).
+            legacy = ple_table_file_name((256, 4), torch.float8_e4m3fn, "rows0-256")
+            self.assertFalse(os.path.exists(os.path.join(d, legacy)))
+            # Same flags the file backend sets, plus the prepared marker.
+            self.assertTrue(table._sglang_ple_prepared)
