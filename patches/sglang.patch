+++ b/test/registered/unit/multimodal/test_vit_graph_cache_bounds.py
@@ -0,0 +1,104 @@
+"""ViT CUDA-graph runner must bound retained per-shape graphs (memory safety).
+
+Pure-CPU test double: exercises only the cache-policy methods; no CUDA graph
+is captured (graph capture itself is GPU-qualified separately).
+"""
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "..", "..", "python"))
+
+import torch  # noqa: F401  (needed so sglang torch imports resolve)
+
+
+def make_runner(max_graphs):
+    from sglang.srt.multimodal.vit_cuda_graph_runner import ViTCudaGraphRunner
+
+    class FakeVit:
+        device = torch.device("cpu")
+        dtype = torch.bfloat16
+        max_context_len = None
+
+        class _B:
+            pass
+
+        blocks = [_B()]
+
+    runner = ViTCudaGraphRunner.__new__(ViTCudaGraphRunner)
+    runner.vit = FakeVit()
+    runner.max_context_len = None
+    runner._max_graphs = max_graphs
+    for name in (
+        "block_input",
+        "block_ws",
+        "block_graphs",
+        "block_output",
+        "cu_full_len",
+        "cu_window_len",
+        "cu_full_len_kk",
+        "cu_window_len_kk",
+    ):
+        setattr(runner, name, {})
+    runner._sin_cos_ws_by_graph = {}
+    runner.sin_cos_ws = None
+    runner._retired_sin_cos_ws = []
+    runner._lru = []
+    runner._inflight = {}
+    return runner
+
+
+def test_retire_evicts_oldest_and_frees():
+    r = make_runner(2)
+    for key in ("a", "b", "c"):
+        r.block_graphs[key] = object()
+        r.block_input[key] = object()
+        r.block_output[key] = object()
+        r.block_ws[key] = object()
+        r.cu_full_len[key] = object()
+        r.cu_full_len_kk[key] = object()
+        r._sin_cos_ws_by_graph[key] = object()
+        r._lru.append(key)
+    r._enforce_graph_budget()
+    assert "a" not in r.block_graphs
+    assert set(r.block_graphs) == {"b", "c"}
+    assert r._lru == ["b", "c"]
+
+
+def test_touch_promotes_key():
+    r = make_runner(2)
+    for key in ("a", "b"):
+        r.block_graphs[key] = object()
+        r._lru.append(key)
+    r._touch("a")
+    r.block_graphs["c"] = object()
+    r._lru.append("c")
+    r._enforce_graph_budget()
+    assert set(r.block_graphs) == {"a", "c"}
+
+
+def test_inflight_keys_are_never_evicted():
+    r = make_runner(2)
+    for key in ("a", "b", "c"):
+        r.block_graphs[key] = object()
+        r._lru.append(key)
+    r._inflight["a"] = 1
+    r._enforce_graph_budget()
+    # 'a' is oldest but in flight; 'b' must be evicted instead
+    assert "a" in r.block_graphs
+    assert "b" not in r.block_graphs
+
+
+def test_retire_is_idempotent():
+    r = make_runner(4)
+    r.block_graphs["a"] = object()
+    r._lru.append("a")
+    r._retire_graph("a")
+    r._retire_graph("a")  # must not raise
+    assert r.block_graphs == {}
+
+
+def test_env_default_is_bounded():
+    from sglang.srt.multimodal.vit_cuda_graph_runner import DEFAULT_VIT_MAX_GRAPHS
+
+    assert isinstance(DEFAULT_VIT_MAX_GRAPHS, int)
+    assert 1 <= DEFAULT_VIT_MAX_GRAPHS <= 64
