+def test_touched_table_mtime_revalidates_content_and_refreshes_receipt(
+    ple, tmp_path, monkeypatch
+):
+    src, plan, model_root, cache = prepare_env(ple, tmp_path)
+    old = ple.prepare_cache(str(model_root), str(cache), plan)
+    table = cache / plan["table"]["name"]
+    os.utime(table, ns=(10**18, 10**18))
+    touched = table.stat()
+    checked = []
+    verify = ple._verify_table_content
+
+    def observed_verify(fd, expected):
+        checked.append(expected["sha256"])
+        return verify(fd, expected)
+
+    def forbidden_copy(*args, **kwargs):
+        raise AssertionError("verified timestamp-only drift must not copy table")
+
+    monkeypatch.setattr(ple, "_verify_table_content", observed_verify)
+    monkeypatch.setattr(ple, "_materialize", forbidden_copy)
+    r = ple.prepare_cache(str(model_root), str(cache), plan)
+    assert checked == [plan["table"]["sha256"]]
+    assert r["mode"] == "reuse" and r["copied_bytes"] == 0
+    current = table.stat()
+    assert all(
+        getattr(current, key) == getattr(touched, key)
+        for key in ("st_dev", "st_ino", "st_size", "st_mtime_ns", "st_ctime_ns")
+    )
+    assert r["receipt_sha256"] != old["receipt_sha256"]
+    with pytest.raises(ple.PleCacheError):
+        ple.open_prepared_table(
+            old["receipt_path"],
+            old["receipt_sha256"],
+            **_open_args(ple, old, src, cache),
+        )
+    fd = ple.open_prepared_table(
+        r["receipt_path"], r["receipt_sha256"], **_open_args(ple, r, src, cache)
+    )
+    os.close(fd)
+
