@@ -0,0 +1,100 @@
+"""ViT graph outputs must outlive later replays and cache hits."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from sglang.srt.mem_cache.multimodal_cache import EmbeddingResult, MultiModalStaticCache
+from sglang.srt.multimodal.vit_cuda_graph_runner import ViTCudaGraphRunner
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=10, suite="base-a-test-cpu")
+
+
+def replay_runner(device, dtype=torch.float32):
+    """Exercise the production replay boundary with fixed graph-owned buffers."""
+    runner = object.__new__(ViTCudaGraphRunner)
+    source = torch.zeros((4, 1, 3), device=device, dtype=dtype)
+    output = torch.empty((4, 3), device=device, dtype=dtype)
+    runner.block_input = {"shape": source}
+    runner.block_output = {"shape": output}
+
+    def forward():
+        torch.add(source.squeeze(1), 7, out=output)
+
+    if device == "cuda":
+        stream = torch.cuda.Stream()
+        stream.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(stream):
+            for _ in range(3):
+                forward()
+        torch.cuda.current_stream().wait_stream(stream)
+        torch.cuda.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            forward()
+    else:
+        graph = SimpleNamespace(replay=forward)
+    runner.block_graphs = {"shape": graph}
+    return runner
+
+
+@pytest.mark.parametrize("dtype", [torch.float32, torch.bfloat16])
+@pytest.mark.parametrize("reorder", [False, True])
+def test_replay_result_is_stable_after_same_shape_replay(dtype, reorder):
+    runner = replay_runner("cpu", dtype)
+    first_input = torch.arange(12, dtype=dtype).reshape(4, 1, 3)
+    indices = torch.tensor([3, 1, 2, 0]) if reorder else None
+    first = runner.replay("shape", first_input, output_indices=indices)
+    expected = first_input.squeeze(1) + 7
+    if indices is not None:
+        expected = expected.index_select(0, indices)
+    second = runner.replay("shape", first_input + 100, output_indices=indices)
+    torch.testing.assert_close(first, expected, rtol=0, atol=0)
+    torch.testing.assert_close(second, expected + 100, rtol=0, atol=0)
+    assert first.untyped_storage().data_ptr() != second.untyped_storage().data_ptr()
+    assert (
+        first.untyped_storage().data_ptr()
+        != runner.block_output["shape"].untyped_storage().data_ptr()
+    )
+
+
+def test_caller_mutation_cannot_modify_graph_output_buffer():
+    runner = replay_runner("cpu")
+    result = runner.replay("shape", torch.ones(4, 1, 3))
+    result.zero_()
+    torch.testing.assert_close(runner.block_output["shape"], torch.full((4, 3), 8.0))
+
+
+def assert_cache_retains_distinct_images(device):
+    runner = replay_runner(device)
+    cache = MultiModalStaticCache(max_size=4096)
+    for image_hash, value in [(101, 1.0), (202, 2.0)]:
+        result = runner.replay("shape", torch.full((4, 1, 3), value, device=device))
+        assert cache.set(image_hash, EmbeddingResult(embedding=result))
+    # Another same-resolution image must not overwrite either cached image.
+    runner.replay("shape", torch.full((4, 1, 3), 3.0, device=device))
+    first = cache.get_single(101).embedding
+    second = cache.get_single(202).embedding
+    pair = torch.cat([first, second])
+    expected = torch.cat(
+        [
+            torch.full((4, 3), 8.0, device=device),
+            torch.full((4, 3), 9.0, device=device),
+        ]
+    )
+    torch.testing.assert_close(pair, expected, rtol=0, atol=0)
+    # A consumer may slice or mutate an independent return, not the graph buffer.
+    assert first.untyped_storage().data_ptr() != second.untyped_storage().data_ptr()
+    assert cache.current_size == 2 * 4 * 3 * 4
+
+
+def test_cached_images_survive_later_graph_replays():
+    assert_cache_retains_distinct_images("cpu")
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="real CUDA graph required")
+def test_real_cuda_graph_cache_owns_distinct_image_outputs():
+    assert_cache_retains_distinct_images("cuda")
+    torch.cuda.synchronize()
