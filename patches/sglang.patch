+def test_short_read_and_short_write_tolerated(ple, tmp_path):
+    src, plan, model_root, cache = prepare_env(ple, tmp_path)
+    real_pread = os.pread
+    real_pwrite = os.pwrite
+
+    def short_pread(fd, n, off):
+        data = real_pread(fd, n, off)
+        return data[: len(data) // 2] if len(data) > 1 else data
+
+    def short_pwrite(fd, data, off):
+        return real_pwrite(fd, data[: max(1, len(data) // 2)], off)
+
+    os.pread = short_pread
+    try:
+        os.pwrite = short_pwrite
+        try:
+            r = ple.prepare_cache(str(model_root), str(cache), plan)
+        finally:
+            os.pwrite = real_pwrite
+    finally:
+        os.pread = real_pread
+    assert r["mode"] == "materialized"
+    table = cache / plan["table"]["name"]
+    assert table.read_bytes() == b"".join(src.payloads[i] for i in range(src.n))
