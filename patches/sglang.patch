+# SPDX-License-Identifier: Apache-2.0
+import copy
+import hashlib
+import json
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from sglang.srt.layers.attention.qsa.kv_calibration import (
+    AmaxCollector, QSAKVCalibrationMixin, SCHEMA, export_qsa_kv_state,
+    load_sidecar, reset_qsa_kv_amax, validate_sidecar,
+)
+
+REV = '1' * 40
+ARGS = dict(model_revision=REV, role='target', layer_ids=[3, 7], heads=2, dim=256)
+
+
+def document():
+    return {'schema': SCHEMA, 'model_revision': REV, 'scale_policy': 'bf16-amax-over-6x448',
+            'pools': {'target': {'layer_ids': [3, 7], 'heads': 2, 'head_dim': 256,
+                                 'observations': [10, 10], 'k_scale': [.01, .02], 'v_scale': [.03, .04]},
+                      'draft': {'layer_ids': [0], 'heads': 2, 'head_dim': 256,
+                                'observations': [10], 'k_scale': [.05], 'v_scale': [.06]}}}
+
+
+def test_valid_sidecar_and_distinct_draft_mapping():
+    assert validate_sidecar(document(), **ARGS)['k_scale'] == pytest.approx([.01, .02])
+    assert validate_sidecar(document(), model_revision=REV, role='draft', layer_ids=[0], heads=2, dim=256)['k_scale'] == pytest.approx([.05])
+
+
+@pytest.mark.parametrize('value', [0, -1, True, float('nan'), float('inf'), 1e-100, 1e100, 1 << 4096])
+def test_reject_bad_scale(value):
+    data = document(); data['pools']['target']['k_scale'][0] = value
+    with pytest.raises(ValueError): validate_sidecar(data, **ARGS)
+
+
+@pytest.mark.parametrize('change', ['revision', 'role', 'layers', 'heads', 'observations'])
+def test_reject_sidecar_identity_or_unobserved_geometry(change):
+    data = document()
+    if change == 'revision': data['model_revision'] = '2' * 40
+    elif change == 'role': del data['pools']['target']
+    elif change == 'layers': data['pools']['target']['layer_ids'] = [0, 1]
+    elif change == 'heads': data['pools']['target']['heads'] = 4
+    else: data['pools']['target']['observations'][0] = 0
+    with pytest.raises(ValueError): validate_sidecar(data, **ARGS)
+
+
+def test_file_hash_and_no_follow(tmp_path):
+    p = tmp_path / 'scales.json'; p.write_text(json.dumps(document())); p.chmod(0o600)
+    digest = hashlib.sha256(p.read_bytes()).hexdigest()
+    assert load_sidecar(str(p), digest, **ARGS)['v_scale'] == pytest.approx([.03, .04])
+    with pytest.raises(ValueError, match='hash mismatch'): load_sidecar(str(p), '0' * 64, **ARGS)
+    link = tmp_path / 'link.json'; link.symlink_to(p)
+    with pytest.raises(OSError): load_sidecar(str(link), digest, **ARGS)
+    p.chmod(0o666)
+    with pytest.raises(ValueError, match='unsafe'): load_sidecar(str(p), digest, **ARGS)
+
+
+def test_duplicate_json_keys_rejected(tmp_path):
+    p = tmp_path / 'duplicate.json'
+    p.write_text('{"schema":"one","schema":"two"}'); p.chmod(0o600)
+    with pytest.raises(ValueError, match='duplicate'):
+        load_sidecar(str(p), hashlib.sha256(p.read_bytes()).hexdigest(), **ARGS)
+
+
+@pytest.mark.parametrize('name', ['get_key_buffer', 'get_value_buffer', 'get_kv_buffer'])
+def test_packed_qsa_rejects_plain_buffer_getters(name):
+    class Base:
+        recipe = 'nvfp4'
+        def get_kv_cache_quant_method(self):return SimpleNamespace(name=self.recipe)
+        def get_key_buffer(self, layer):return ('key', layer)
+        def get_value_buffer(self, layer):return ('value', layer)
+        def get_kv_buffer(self, layer):return ('kv', layer)
+    class Pool(QSAKVCalibrationMixin, Base):pass
+    pool=Pool()
+    with pytest.raises(ValueError, match='raw'):
+        getattr(pool,name)(3)
+    pool.recipe='none'
+    assert getattr(pool,name)(3)[1]==3
+
+
+def test_control_request_preserves_reset_boolean():
+    from pydantic import TypeAdapter
+    from sglang.srt.managers.io_struct import SetInternalStateReq
+    req=TypeAdapter(SetInternalStateReq).validate_python({'server_args':{'qsa_kv_amax_reset':True}})
+    assert req.server_args['qsa_kv_amax_reset'] is True
+
+
+def test_cpu_collector_preserves_global_layer_order_and_running_max():
+    c = AmaxCollector('target', [3, 7], 2, 256, 'cpu', REV)
+    c.observe(7, torch.tensor([-2., 3.]), torch.tensor([-5., 4.]))
+    c.observe(7, torch.tensor([1.]), torch.tensor([2.]))
+    data = c.export()
+    assert data['layer_ids'] == [3, 7]
+    assert data['k_amax'] == [0., 3.] and data['v_amax'] == [0., 5.]
+    assert data['observations'] == [0, 2]
+    c.reset(); assert c.export()['observations'] == [0, 0]
+
+
+def test_nvfp4_requires_bound_sidecar_and_installs_global_scales(monkeypatch, tmp_path):
+    data = document(); path = tmp_path / 'scales.json'
+    path.write_text(json.dumps(data)); path.chmod(0o600)
+    method = SimpleNamespace(name='nvfp4', k_scales_gpu=torch.ones(2), v_scales_gpu=torch.ones(2))
+    class Base:
+        def get_kv_cache_quant_method(self): return method
+    class Pool(QSAKVCalibrationMixin, Base): pass
+    p = Pool()
+    monkeypatch.setenv('SGLANG_QSA_KV_AMAX_CALIB', '0')
+    monkeypatch.setenv('SGLANG_QSA_KV_MODEL_REVISION', REV)
+    monkeypatch.setenv('SGLANG_QSA_KV_SCALE_SIDECAR', str(path))
+    monkeypatch.delenv('SGLANG_QSA_KV_SCALE_SHA256', raising=False)
+    with pytest.raises(ValueError, match='hash must be explicit'):
+        p._init_qsa_kv_scales(role='target', layer_ids=[3,7], heads=2, dim=256, dtype=torch.float4_e2m1fn_x2, device='cpu')
+    monkeypatch.setenv('SGLANG_QSA_KV_SCALE_SHA256', hashlib.sha256(path.read_bytes()).hexdigest())
+    p._init_qsa_kv_scales(role='target', layer_ids=[3,7], heads=2, dim=256, dtype=torch.float4_e2m1fn_x2, device='cpu')
+    assert method.k_scales_gpu.numel() == 8
+    assert method.k_scales_gpu[[3,7]].tolist() == pytest.approx([.01,.02])
+    assert method.v_scales_gpu[[3,7]].tolist() == pytest.approx([.03,.04])
+    assert method.k_scales_gpu[0].item() == 1.
+    state = export_qsa_kv_state()
+    assert any(r['role']=='target' and r['layer_ids']==[3,7] for r in state['scale_receipts'])
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason='CUDA graph required')
+def test_collector_tracks_changed_inputs_in_graph_without_cpu_forward_reads():
+    c = AmaxCollector('draft', [0], 2, 256, 'cuda', REV)
+    k = torch.tensor([2.], device='cuda', dtype=torch.bfloat16)
+    v = torch.tensor([-4.], device='cuda', dtype=torch.bfloat16)
+    c.observe(0, k, v)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph): c.observe(0, k, v)
+    k.fill_(-7.); v.fill_(1.)
+    graph.replay(); torch.cuda.synchronize()
+    assert c.export()['k_amax'] == [7.] and c.export()['v_amax'] == [4.]
+    k.fill_(1.); v.fill_(9.)
+    graph.replay(); torch.cuda.synchronize()
+    assert c.export()['k_amax'] == [7.] and c.export()['v_amax'] == [9.]
+    reset_qsa_kv_amax()
+    assert c.export()['observations'] == [0] and c.export()['k_amax'] == [0.]
