+@cute.experimental.jit
+def _bmm_gate(
+    gemm_op: cutlass.Constexpr,
+    a: cute.Tensor,
+    b: cute.Tensor,
+    c: cute.Tensor,
+    x: cute.Tensor,
+    out: cute.Tensor,
