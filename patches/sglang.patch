+    def test_prepared_mapping_survives_fd_close(self):
+        # Proof that torch.from_file on /proc/self/fd/N does not depend on the
+        # descriptor staying open after the map (mapping + bytes preserved).
+        with tempfile.TemporaryDirectory() as d:
+            payload = b"\x5a" * 512
+            table_path = os.path.join(d, "anchor.bin")
+            _write_table(table_path, payload)
+            fd = os.open(table_path, os.O_RDONLY)
+            try:
+                storage = torch.from_file(
+                    f"/proc/self/fd/{fd}", shared=True, size=512, dtype=torch.uint8
+                )
+            finally:
+                os.close(fd)
+            self.assertEqual(bytes(storage.flatten().tolist()), payload)
+            storage[10] = 0x33
+            with open(table_path, "rb") as f:
+                self.assertEqual(f.read(11), b"\x5a" * 10 + b"\x33")
