+            later = (10**18, 10**18)
+            os.utime(str(src.path), ns=later)
+        return real_pwrite(fd, data, off)
+
+    os.pwrite = meddling_pwrite
+    try:
+        with pytest.raises(ple.PleCacheError):
+            ple.prepare_cache(str(model_root), str(cache), plan)
+    finally:
+        os.pwrite = real_pwrite
+    leftovers = [p.name for p in cache.iterdir() if ".tmp-" in p.name]
+    assert leftovers == []
+    assert not (cache / "prepared.json").exists()
