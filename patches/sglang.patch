+# SPDX-License-Identifier: Apache-2.0
+"""QSA NVFP4 storage reads: native GPU equivalence and graph ownership."""
+from types import SimpleNamespace
+import pytest
+import torch
+
+from sglang.srt.layers.attention.qsa.nvfp4 import (
+    compact_nvfp4_kv, dequantize_nvfp4_rows, raw_nvfp4_layer, validate_buffers,
+)
+from sglang.srt.layers.attention.qsa.sparse_attn import qwen_sparse_fa2_cu_seqlens_triton
+from sglang.srt.layers.attention.qwen_sparse_attn_backend import QwenSparseAttnBackend
+
+GPU = torch.cuda.is_available() and torch.cuda.get_device_capability() == (12, 1)
+
