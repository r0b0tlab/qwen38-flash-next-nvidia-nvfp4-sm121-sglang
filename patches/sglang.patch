@@ -0,0 +1,912 @@
+"""Unit tests for the bounded pure-stdlib PLE cache materializer.
+
+These tests run under a plain stdlib pytest (no SGLang / torch import needed).
+The module under test is loaded by file path via importlib inside a fixture,
+so collection succeeds even before the module exists (TDD RED state).
+"""
+
+import fcntl
+import hashlib
+import importlib.util
+import json
+import math
+import os
+import stat
+import struct
+import sys
+from pathlib import Path
+
+import pytest
+
+TEST_FILE = Path(__file__).resolve()
+WORKTREE = TEST_FILE.parents[4]
+MODULE_PATH = (
+    WORKTREE / "python" / "sglang" / "srt" / "models" / "qwen4_exp_ple_cache.py"
+)
+
+MODEL_ID = "nvidia/Qwen3.8-Flash-Next-NVFP4"
+REVISION = "fc694b54fb0174e0913e6adf86691ef85a4ead47"
+PREFIX = "model.layers.3.mlp.experts"
+ROWS = 4
+WIDTH = 8
+PERM = [5, 2, 0, 4, 1, 3]  # physical slot -> numeric shard id (non-identity)
+
+_IMPORTED_NEW = None
+_LOADED = None
+
+
+def _load_module():
+    global _LOADED, _IMPORTED_NEW
+    if _LOADED is None:
+        if not MODULE_PATH.exists():
+            pytest.fail(f"module under test not implemented yet: {MODULE_PATH}")
+        before = frozenset(sys.modules)
+        spec = importlib.util.spec_from_file_location(
+            "qwen4_exp_ple_cache", MODULE_PATH
+        )
+        assert spec is not None and spec.loader is not None
+        mod = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(mod)
+        _LOADED = mod
+        _IMPORTED_NEW = frozenset(sys.modules) - before
+    return _LOADED
+
+
+@pytest.fixture(scope="module")
+def ple():
+    return _load_module()
+
+
+# --------------------------------------------------------------------------
+# fixtures
+
+
+def _table_name(total_rows, width):
+    size = total_rows * width
+    return (
+        f"ple_table_{total_rows}x{width}_float8_e4m3fn_{size}B_rows0-{total_rows}.bin"
+    )
+
+
+def _shard_payload(sid, rows, width):
+    return bytes(
+        ((sid * 37 + r * 11 + c * 3) & 0xFF) for r in range(rows) for c in range(width)
+    )
+
+
+def _write_safetensors(path, tensors):
+    """tensors: list of (name, dtype, shape, payload) laid out in list order."""
+    header = {"__metadata__": {"format": "pt"}}
+    off = 0
+    body = b""
+    for name, dtype, shape, payload in tensors:
+        header[name] = {
+            "dtype": dtype,
+            "shape": list(shape),
+            "data_offsets": [off, off + len(payload)],
+        }
+        body += payload
+        off += len(payload)
+    hb = json.dumps(header, separators=(",", ":")).encode("ascii")
+    hb += b" " * ((8 - (len(hb) % 8)) % 8)
+    blob = struct.pack("<Q", len(hb)) + hb + body
+    path.write_bytes(blob)
+    return blob
+
+
+class _Src:
+    def __init__(self, path, blob, perm, rows, width, prefix, payloads, scale):
+        self.path = path
+        self.blob = blob
+        self.perm = perm
+        self.rows = rows
+        self.width = width
+        self.prefix = prefix
+        self.payloads = payloads
+        self.scale = scale
+        self.sha = hashlib.sha256(blob).hexdigest()
+
+    @property
+    def n(self):
+        return len(self.perm)
+
+    @property
+    def shard_bytes(self):
+        return self.rows * self.width
+
+    @property
+    def total_rows(self):
+        return self.n * self.rows
+
+
+def make_source(root, *, perm=PERM, rows=ROWS, width=WIDTH, prefix=PREFIX, extra=True):
+    root.mkdir(parents=True, exist_ok=True)
+    path = root / "ple_src.safetensors"
+    payloads = {sid: _shard_payload(sid, rows, width) for sid in range(len(perm))}
+    scale = b"\x3c\x40"
+    tensors = []
+    if extra:
+        tensors.append(
+            (
+                "model.embed_tokens.weight",
+                "BF16",
+                [2, 2],
+                b"\x01\x02\x03\x04\x05\x06\x07\x08",
+            )
+        )
+    for slot, sid in enumerate(perm):
+        tensors.append(
+            (f"{prefix}.shard_{sid}.weight", "F8_E4M3", [rows, width], payloads[sid])
+        )
+    tensors.append((f"{prefix}.weight_scale", "BF16", [1], scale))
+    blob = _write_safetensors(path, tensors)
+    return _Src(path, blob, perm, rows, width, prefix, payloads, scale)
+
+
+def make_plan(ple, src, **over):
+    kw = {
+        "model_id": MODEL_ID,
+        "model_revision": REVISION,
+        "tensor_prefix": src.prefix,
+        "shard_count": src.n,
+        "rows_per_shard": src.rows,
+        "row_width": src.width,
+        "source_sha256": src.sha,
+    }
+    kw.update(over)
+    return ple.build_plan(str(src.path), **kw)
+
+
+def prepare_env(ple, tmp_path, *, perm=PERM, rows=ROWS, width=WIDTH):
+    model_root = tmp_path / "model"
+    cache = tmp_path / "cache"
+    src = make_source(model_root, perm=perm, rows=rows, width=width)
+    plan = make_plan(ple, src)
+    return src, plan, model_root, cache
+
+
+def canonical_bytes(obj):
+    return json.dumps(
+        obj, sort_keys=True, separators=(",", ":"), ensure_ascii=True
+    ).encode("ascii")
+
+
+# --------------------------------------------------------------------------
+# module hygiene
+
+
+def test_module_is_pure_stdlib(ple):
+    assert _IMPORTED_NEW is not None
+    banned = ("torch", "numpy", "sglang", "transformers", "triton", "zlib_ng")
+    for name in _IMPORTED_NEW:
+        root = name.split(".", 1)[0]
+        assert root not in banned, f"module imported third-party package: {name}"
+    text = MODULE_PATH.read_text(encoding="utf-8")
+    assert "import torch" not in text
+    assert "from torch" not in text
+
+
+def test_module_compiles(ple):
+    compile(MODULE_PATH.read_text(encoding="utf-8"), str(MODULE_PATH), "exec")
+
+
+# --------------------------------------------------------------------------
+# build_plan / validate_plan
+
+
+def test_build_plan_schema_and_absolute_offsets(ple, tmp_path):
+    src = make_source(tmp_path / "m")
+    plan = make_plan(ple, src)
+    header_len = struct.unpack("<Q", src.blob[:8])[0]
+    data_start = 8 + header_len
+    assert plan["schema"] == "qwen38fn.ple-plan.v1"
+    assert plan["model"] == {"id": MODEL_ID, "revision": REVISION}
+    assert plan["dtype"] == "F8_E4M3"
+    assert plan["tensor_prefix"] == src.prefix
+    assert plan["source"]["name"] == "ple_src.safetensors"
+    assert plan["source"]["size"] == len(src.blob)
+    assert plan["source"]["sha256"] == src.sha
+    assert plan["source"]["data_start"] == data_start
+    assert plan["shard_count"] == src.n
+    assert plan["rows_per_shard"] == src.rows
