+        cute.make_tensor(b.iterator, cute.select(b.layout, mode=[2, 1, 0])),
+        c_swapped,
+        cute.make_tensor(bias.iterator, cute.select(bias.layout, mode=[1, 2, 0])),
+        c_swapped,
+        c_swapped,
+        stream,
+    )
